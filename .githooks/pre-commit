#!/usr/bin/env bash
# Fusion Pre-commit Hook
# Enforces Fusion Flux Engine policy and scope boundaries before commits

set -e

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

echo "${CYAN}🔍 Running Fusion Pre-commit Hook...${NC}"
echo ""

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)
VIOLATIONS=0
WARNINGS=0
REVIEW_REQUIRED=0

# Repo root and --no-verify bypass audit engine
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
BYPASS_AUDIT="$REPO_ROOT/scripts/bypass_audit.sh"

# Writes a freshness marker "<head> <staged-tree>" recording the current HEAD
# (the parent-to-be) and the staged tree that will be committed, so the
# post-commit hook can tell whether pre-commit actually ran for the new commit.
# A missing/stale marker at post-commit time means --no-verify was used. Binding
# the staged tree defeats a stale marker left by an aborted commit that is later
# re-attempted with --no-verify and different content.
write_precommit_marker() {
    local gitdir head tree
    gitdir="$(git rev-parse --git-dir 2>/dev/null)"
    [ -z "$gitdir" ] && return 0
    head="$(git rev-parse --verify --quiet HEAD 2>/dev/null || echo ROOT)"
    tree="$(git write-tree 2>/dev/null || echo NOTREE)"
    printf '%s %s' "$head" "$tree" > "$gitdir/fusion_precommit_marker"
}

#================================================================================
# SECTION 0: ESCALATION GATE (block while a high-risk bypass awaits approval)
#================================================================================
if [ -f "$BYPASS_AUDIT" ]; then
    if ! bash "$BYPASS_AUDIT" gate; then
        exit 1
    fi
fi

#================================================================================
# SECTION 1: SCOPE BOUNDARY ENFORCEMENT (Hard Blocks)
#================================================================================
echo "${CYAN}━━━ Scope Boundary Validation ━━━${NC}"

# Block commits to bin/ directory (prebuilt binaries)
for file in $STAGED_FILES; do
    if [[ "$file" == bin/* ]]; then
        echo -e "${RED}❌ BLOCKED: Changes to bin/ directory are prohibited${NC}"
        echo "   File: $file"
        echo "   Reason: bin/ contains prebuilt binaries. Regenerate via scripts/bootstrap_native.ps1"
        echo "   Action: Remove from staging with 'git reset HEAD <file>'"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
done

# Block commits to target/ directories (build artifacts)
for file in $STAGED_FILES; do
    if [[ "$file" == target/* ]] || [[ "$file" == target_*/* ]]; then
        echo -e "${RED}❌ BLOCKED: Changes to target directories are prohibited${NC}"
        echo "   File: $file"
        echo "   Reason: target/ contains build artifacts that should not be committed"
        echo "   Action: Add to .gitignore and remove from staging"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
done

# Block commits of compiled build artifacts at the repository root
# (only additions/modifications -- staged deletions must be allowed so the
#  cleanup script's removals can be committed)
for file in $(git diff --cached --name-only --diff-filter=d); do
    # Only consider root-level files (no directory separator in the path)
    case "$file" in
        */*) continue ;;
    esac
    case "$file" in
        *.exe|*.obj|*.o|*.ll|*.bc|*.map|*.pdb)
            echo -e "${RED}❌ BLOCKED: Compiled build artifact staged at repository root${NC}"
            echo "   File: $file"
            echo "   Reason: Root-level build output (.exe/.obj/.o/.stage.o/.ll/.bc/.map/.pdb) must not be committed"
            echo "   Action: Run 'powershell -File scripts/clean_root_artifacts.ps1' then 'git reset HEAD $file'"
            VIOLATIONS=$((VIOLATIONS + 1))
            ;;
    esac
done

# Block commits to Cargo.lock (unless intentional)
for file in $STAGED_FILES; do
    if [[ "$file" == "Cargo.lock" ]]; then
        echo -e "${YELLOW}⚠️  WARNING: Changes to Cargo.lock detected${NC}"
        echo "   File: $file"
        echo "   Reason: Cargo.lock should only be updated via cargo commands, never hand-edited"
        echo "   Action: If intentional, use 'git commit --no-verify' with justification"
        WARNINGS=$((WARNINGS + 1))
    fi
done

#================================================================================
# SECTION 2: HIGH-RISK AREA REVIEW TRIGGERS
#================================================================================
echo ""
echo "${CYAN}━━━ High-Risk Area Review ━━━${NC}"

# Define high-risk paths
COMPILER_CRATE="crates/fuc/src/"
RUNTIME_DIR="runtime/"
STDLIB_SECURITY_FILES=("security.fu" "hybrid_crypto.fu" "ed25519.fu" "x25519.fu" "weave_kem.fu" "weave_sig.fu" "sha3.fu")
CRITICAL_COMPILER_FILES=("parser.rs" "sema.rs" "codegen/" "ir_lower.rs" "main.rs")

# Check for compiler crate changes
for file in $STAGED_FILES; do
    if [[ "$file" == "$COMPILER_CRATE"* ]]; then
        REVIEW_REQUIRED=$((REVIEW_REQUIRED + 1))
        echo -e "${YELLOW}⚠️  REVIEW REQUIRED: Compiler crate modification${NC}"
        echo "   File: $file"
        echo "   Risk: Compiler changes can affect all Fusion programs"
        echo "   Required: Run 'cargo build -p fuc' and 'scripts/run_native_regression.ps1'"
        
        # Flag critical compiler files
        for critical in "${CRITICAL_COMPILER_FILES[@]}"; do
            if [[ "$file" == *"$critical" ]]; then
                echo -e "   ${RED}🔴 CRITICAL: This is a core compiler file - requires thorough review${NC}"
            fi
        done
    fi
done

# Check for runtime changes
for file in $STAGED_FILES; do
    if [[ "$file" == "$RUNTIME_DIR"* ]]; then
        REVIEW_REQUIRED=$((REVIEW_REQUIRED + 1))
        echo -e "${YELLOW}⚠️  REVIEW REQUIRED: Runtime modification${NC}"
        echo "   File: $file"
        echo "   Risk: Runtime changes affect program execution"
        echo "   Required: Run 'cmake -B cmake_build -DCMAKE_BUILD_TYPE=Release && cmake --build cmake_build'"
    fi
done

# Check for stdlib security-sensitive file changes
for file in $STAGED_FILES; do
    for sec_file in "${STDLIB_SECURITY_FILES[@]}"; do
        if [[ "$file" == *"$sec_file" ]]; then
            REVIEW_REQUIRED=$((REVIEW_REQUIRED + 1))
            echo -e "${YELLOW}⚠️  REVIEW REQUIRED: Security-sensitive stdlib modification${NC}"
            echo "   File: $file"
            echo "   Risk: Security files require careful review for vulnerabilities"
            echo "   Required: Run security gate and verify no unsafe code introduced"
        fi
    done
done

#================================================================================
# SECTION 3: BUILD POLICY COMPLIANCE
#================================================================================
echo ""
echo "${CYAN}━━━ Build Policy Compliance ━━━${NC}"

# Check for prohibited cargo commands in staged files
for file in $STAGED_FILES; do
    if [[ -f "$file" ]]; then
        case "$file" in
            *.sh|*.ps1|*.bash|*.yml|*.yaml|Makefile)
                # Check for cargo build/test/run commands
                if grep -qE "(^|[^#])(cargo (build|test|run|check))" "$file" 2>/dev/null; then
                    # Exempt runtime directory, CI workflow files, and pre-commit hooks themselves
                    if [[ ! "$file" =~ ^runtime/ ]] && [[ ! "$file" =~ ^.github/workflows/ ]] && [[ ! "$file" =~ ^.githooks/ ]]; then
                        echo -e "${RED}❌ Policy violation in: $file${NC}"
                        echo "   Contains prohibited 'cargo' command"
                        echo "   Use 'fusion build/test/run' instead"
                        VIOLATIONS=$((VIOLATIONS + 1))
                    fi
                fi
                ;;
        esac
    fi
done

# Check BUILD_POLICY.md is not being removed
if git diff --cached --name-status | grep -q "^D.*BUILD_POLICY.md"; then
    echo -e "${RED}❌ Cannot delete BUILD_POLICY.md${NC}"
    echo "   This file is required for policy enforcement"
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# Check .fusion/build-policy.json is not being removed
if git diff --cached --name-status | grep -q "^D.*.fusion/build-policy.json"; then
    echo -e "${RED}❌ Cannot delete .fusion/build-policy.json${NC}"
    echo "   This file is required for policy enforcement"
    VIOLATIONS=$((VIOLATIONS + 1))
fi

#================================================================================
# SECTION 4: VALIDATION SEQUENCE (AGENTS.md steps 1-4)
#================================================================================
echo ""
echo "${CYAN}━━━ Validation Sequence (AGENTS.md steps 1-4) ━━━${NC}"

# Detect staged Rust/TOML files
RUST_FILES=""
for file in $STAGED_FILES; do
    case "$file" in
        *.rs|Cargo.toml|crates/*/Cargo.toml)
            RUST_FILES="$RUST_FILES $file"
            ;;
    esac
done

if [ -z "$RUST_FILES" ]; then
    echo "${GREEN}No Rust files staged -- skipping validation sequence${NC}"
else
    echo "Staged Rust/TOML files:$RUST_FILES"
    echo ""

    VALIDATION_FAILED=0

    # Step 1: Format Check
    echo "${YELLOW}Step 1/4: cargo fmt --all -- --check${NC}"
    if cargo fmt --all -- --check 2>&1; then
        echo -e "${GREEN}Format check passed${NC}"
    else
        echo -e "${RED}Format check FAILED${NC}"
        echo "Run 'cargo fmt --all' to fix formatting, then re-stage."
        VALIDATION_FAILED=1
    fi

    # Step 2: Clippy Lint
    echo ""
    echo "${YELLOW}Step 2/4: cargo clippy --all-targets --all-features -- -D warnings${NC}"
    if cargo clippy --all-targets --all-features -- -D warnings 2>&1; then
        echo -e "${GREEN}Clippy check passed${NC}"
    else
        echo -e "${RED}Clippy check FAILED${NC}"
        echo "Fix the warnings above before committing."
        VALIDATION_FAILED=1
    fi

    # Step 3: Build
    echo ""
    echo "${YELLOW}Step 3/4: cargo build --verbose --all-features${NC}"
    if cargo build --verbose --all-features 2>&1; then
        echo -e "${GREEN}Build passed${NC}"
    else
        echo -e "${RED}Build FAILED${NC}"
        echo "Fix build errors above before committing."
        VALIDATION_FAILED=1
    fi

    # Step 4: Test
    echo ""
    echo "${YELLOW}Step 4/4: cargo test --verbose --all-features${NC}"
    if cargo test --verbose --all-features 2>&1; then
        echo -e "${GREEN}Tests passed${NC}"
    else
        echo -e "${RED}Tests FAILED${NC}"
        echo "Fix failing tests above before committing."
        VALIDATION_FAILED=1
    fi

    # Report validation results
    if [ $VALIDATION_FAILED -gt 0 ]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}Validation sequence FAILED${NC}"
        echo -e "${RED}Fix the errors above before committing.${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    else
        echo ""
        echo -e "${GREEN}All validation checks passed${NC}"
    fi
fi

#================================================================================
# SECTION 5: REPORT RESULTS
#================================================================================
echo ""
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ $VIOLATIONS -gt 0 ]; then
    echo -e "${RED}❌ COMMIT BLOCKED: $VIOLATIONS violation(s) detected${NC}"
    echo ""
    echo "Please fix the violations above before committing."
    echo "See BUILD_POLICY.md for details."
    echo ""
    echo "To bypass (emergency only):"
    echo "  git commit --no-verify"
    echo "  NOTE: --no-verify on crates/fuc/, runtime/, or stdlib/ is audited"
    echo "        to .fusion/audit/no-verify-bypass.log and requires approval."
    echo ""
    exit 1
fi

if [ $WARNINGS -gt 0 ] || [ $REVIEW_REQUIRED -gt 0 ]; then
    write_precommit_marker
    echo -e "${YELLOW}⚠️  COMMIT ALLOWED WITH WARNINGS: $WARNINGS warning(s), $REVIEW_REQUIRED review(s) required${NC}"
    echo ""
    echo "The commit will proceed, but please address the following:"
    if [ $REVIEW_REQUIRED -gt 0 ]; then
        echo "  - Complete required reviews and validation steps"
        echo "  - Run appropriate test suites"
        echo "  - Document any risk mitigation"
    fi
    if [ $WARNINGS -gt 0 ]; then
        echo "  - Review warnings above"
    fi
    echo ""
    exit 0
fi

write_precommit_marker
echo -e "${GREEN}✅ All checks passed - commit allowed${NC}"
exit 0
