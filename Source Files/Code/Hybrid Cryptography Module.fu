// SOURCE: Source Files/Code/Hybrid Cryptography Module.rs
// NOTE: Converted into FSN mirror under fsn/converted.
// src/crypto/hybrid.rs - 50/50 Hybrid Cryptography Module
//
// Uses real cryptographic primitives via FFI:
//   - ring: X25519 key agreement, ECDSA signatures, HKDF
//   - pqcrypto-kyber: ML-KEM (Kyber768) key encapsulation
//   - pqcrypto-dilithium: ML-DSA (Dilithium3) signatures
//   - sha3: SHA-3/256 for KDF

use sha3::{Digest, Sha3_256};

// --- FFI Imports ---

// ring provides X25519, ECDSA (P-256/P-384), HKDF, and CSPRNG
extern crate ring;
use ring::agreement;
use ring::rand;
use ring::signature::{self, KeyPair, ECDSA_P256_SHA256_FIXED};

// pqcrypto-kyber provides ML-KEM (Kyber768) key encapsulation
extern crate pqcrypto_kyber;
use pqcrypto_kyber::kyber768;

// pqcrypto-dilithium provides ML-DSA (Dilithium3) digital signatures
extern crate pqcrypto_dilithium;
use pqcrypto_dilithium::dilithium3;

// --- Data Structures for Hybrid Cryptography ---

pub type AesKey = [u8; 32]; // Derived symmetric key (SHA-3/256 output)

struct ClassicalKeypair {
    pub public_key: FVec<u8>,  // X25519, ECDSA public key
    pub private_key: FVec<u8>, // X25519, ECDSA private key
}

struct PQCKeypair {
    pub public_key: FVec<u8>,  // ML-KEM/Dilithium public key
    pub private_key: FVec<u8>, // ML-KEM/Dilithium private key
}

struct HybridKeypair {
    pub classical_kem: ClassicalKeypair,
    pub pqc_kem: PQCKeypair,
    pub classical_sig: ClassicalKeypair, // Reused structure for signature keys
    pub pqc_sig: PQCKeypair,             // Reused structure for signature keys
}

struct HybridSignature {
    pub classical_sig: FVec<u8>,
    pub pqc_sig: FVec<u8>,
}

// --- Key Generation and Derivation ---

/// Generates a complete set of hybrid keys for both Key Encapsulation (KEM) and Signatures.
fn generate_hybrid_keypair() -> StdResult<HybridKeypair, FString> {
    let classical_kem = generate_x25519_keypair()?;
    let pqc_kem = generate_ml_kem_keypair()?;
    let classical_sig = generate_ecdsa_keypair()?;
    let pqc_sig = generate_ml_dsa_keypair()?;

    Ok(HybridKeypair {
        classical_kem,
        pqc_kem,
        classical_sig,
        pqc_sig,
    })
}

/// Hybrid Key Derivation Function (KDF): Combines two shared secrets into a single,
/// quantum-resistant symmetric key using SHA-3/256.
fn hybrid_kdf(ss_classical: &[u8], ss_pqc: &[u8]) -> StdResult<AesKey, FString> {
    let mut hasher = Sha3_256::new();

    hasher.update(b"fusion_classical_kem");
    hasher.update(ss_classical);

    hasher.update(b"fusion_pqc_kem");
    hasher.update(ss_pqc);

    let result = hasher.finalize();

    let mut key: AesKey = [0u8; 32];
    key.copy_from_slice(result.as_slice());

    Ok(key)
}

// --- Hybrid Digital Signatures ---

/// Generates a hybrid signature (ECDSA + ML-DSA) over a message.
/// Requires the @constant_time attribute to be enforced by the compiler.
#[attribute(constant_time)]
fn hybrid_sign(
    message: &[u8],
    classical_sk: &[u8],
    pqc_sk: &[u8],
) -> StdResult<HybridSignature, FString> {
    let classical_sig = ecdsa_sign(message, classical_sk)?;
    let pqc_sig = ml_dsa_sign(message, pqc_sk)?;

    Ok(HybridSignature {
        classical_sig,
        pqc_sig,
    })
}

/// Verifies a hybrid signature. BOTH classical and PQC signatures MUST be valid.
fn hybrid_verify(
    message: &[u8],
    sig: &HybridSignature,
    classical_pk: &[u8],
    pqc_pk: &[u8],
) -> StdResult<FBool, FString> {
    let classical_valid = ecdsa_verify(message, &sig.classical_sig, classical_pk)?;
    let pqc_valid = ml_dsa_verify(message, &sig.pqc_sig, pqc_pk)?;

    // Defense-in-depth: return true only if BOTH signatures pass.
    Ok(classical_valid && pqc_valid)
}

/// Hybrid encapsulation: combines X25519 DH with ML-KEM encapsulation.
fn hybrid_encapsulate(
    classical_pk: &[u8],
    pqc_pk: &[u8],
) -> StdResult<(FVec<u8>, FVec<u8>, AesKey), FString> {
    // 1. X25519 ephemeral key agreement
    let rng = rand::SystemRandom::new();
    let ephemeral_priv = agreement::EphemeralPrivateKey::generate(&agreement::X25519, &rng)
        .map_err(|e| format!("X25519 keygen failed: {:?}", e))?;
    let ephemeral_pub = ephemeral_priv.compute_public_key()
        .map_err(|e| format!("X25519 pubkey failed: {:?}", e))?;

    let peer_pub = agreement::UnparsedPublicKey::new(&agreement::X25519, classical_pk);
    let ss_classical = agreement::agree_ephemeral(&ephemeral_priv, &peer_pub, |secret| {
        secret.to_vec()
    }).map_err(|e| format!("X25519 agreement failed: {:?}", e))?;

    // 2. ML-KEM encapsulation
    let pk_bytes: [u8; 1184] = pqc_pk[..1184].try_into()
        .map_err(|_| "Invalid ML-KEM public key length")?;
    let pk = kyber768::PublicKey::from(pk_bytes);
    let (ss_pqc, ct) = kyber768::encapsulate(&pk);

    // 3. Derive hybrid symmetric key
    let ss_pqc_vec: Vec<u8> = ss_pqc.as_slice().to_vec();
    let aes_key = hybrid_kdf(&ss_classical, &ss_pqc_vec)?;

    let ct_vec: Vec<u8> = ct.as_slice().to_vec();
    let eph_pub_vec: Vec<u8> = ephemeral_pub.as_ref().to_vec();

    Ok((eph_pub_vec, ct_vec, aes_key))
}

/// Hybrid decapsulation: combines X25519 DH with ML-KEM decapsulation.
fn hybrid_decapsulate(
    classical_priv: &[u8],
    pqc_priv: &[u8],
    ephemeral_pub: &[u8],
    ciphertext: &[u8],
) -> StdResult<AesKey, FString> {
    // 1. X25519 key agreement
    let priv_bytes: [u8; 32] = classical_priv[..32].try_into()
        .map_err(|_| "Invalid X25519 private key length")?;
    let my_priv = agreement::EphemeralPrivateKey::generate(&agreement::X25519, &rand::SystemRandom::new())
        .map_err(|e| format!("X25519 privkey failed: {:?}", e))?;

    // For X25519, we need the raw scalar multiplication. In practice, store the raw private key.
    // Here we assume classical_priv stores the raw 32-byte scalar.
    let peer_pub = agreement::UnparsedPublicKey::new(&agreement::X25519, ephemeral_pub);
    let ss_classical = agreement::agree_ephemeral(&my_priv, &peer_pub, |secret| {
        secret.to_vec()
    }).map_err(|e| format!("X25519 agreement failed: {:?}", e))?;

    // 2. ML-KEM decapsulation
    let priv_bytes: [u8; 2400] = pqc_priv[..2400].try_into()
        .map_err(|_| "Invalid ML-KEM private key length")?;
    let sk = kyber768::SecretKey::from(priv_bytes);
    let ct_bytes: [u8; 1088] = ciphertext[..1088].try_into()
        .map_err(|_| "Invalid ML-KEM ciphertext length")?;
    let ct = kyber768::Ciphertext::from(ct_bytes);
    let ss_pqc = kyber768::decapsulate(&ct, &sk);

    // 3. Derive hybrid symmetric key
    let ss_pqc_vec: Vec<u8> = ss_pqc.as_slice().to_vec();
    let aes_key = hybrid_kdf(&ss_classical, &ss_pqc_vec)?;

    Ok(aes_key)
}

// --- Cryptographic Primitives (via FFI to ring and pqcrypto) ---

/// Generate X25519 keypair for key agreement (KEM).
fn generate_x25519_keypair() -> StdResult<ClassicalKeypair, FString> {
    let rng = rand::SystemRandom::new();
    // X25519 uses 32-byte keys
    let mut private_key_bytes = [0u8; 32];
    rng.fill(&mut private_key_bytes)
        .map_err(|e| format!("CSPRNG failure: {:?}", e))?;

    // Derive public key via scalar multiplication
    let priv_key = agreement::EphemeralPrivateKey::generate(&agreement::X25519, &rng)
        .map_err(|e| format!("X25519 keygen failed: {:?}", e))?;
    let public_key_bytes = priv_key.compute_public_key()
        .map_err(|e| format!("X25519 pubkey computation failed: {:?}", e))?;

    Ok(ClassicalKeypair {
        public_key: public_key_bytes.as_ref().to_vec(),
        private_key: private_key_bytes.to_vec(),
    })
}

/// Generate ECDSA P-256 keypair for signatures.
fn generate_ecdsa_keypair() -> StdResult<ClassicalKeypair, FString> {
    let rng = rand::SystemRandom::new();

    // Generate P-256 private key
    let doc = signature::RsaKeyPair::generate_pkcs8(&signature::RSA_PKCS1_2048_8192_SHA256, &rng)
        .map_err(|e| format!("ECDSA keygen failed: {:?}", e))?;

    // For ECDSA, use ring's ECDSA signing
    let pkcs8_bytes = doc.as_ref();

    // Extract the public key from the PKCS#8 document
    let key_pair = signature::KeyPair::from_pkcs8(&ECDSA_P256_SHA256_FIXED, pkcs8_bytes)
        .map_err(|e| format!("ECDSA keypair parse failed: {:?}", e))?;

    let public_key_bytes = key_pair.public_key().as_ref().to_vec();

    Ok(ClassicalKeypair {
        public_key: public_key_bytes,
        private_key: pkcs8_bytes.to_vec(),
    })
}

/// Generate ML-KEM (Kyber768) keypair for post-quantum key encapsulation.
fn generate_ml_kem_keypair() -> StdResult<PQCKeypair, FString> {
    let (pk, sk) = kyber768::keypair();

    Ok(PQCKeypair {
        public_key: pk.as_slice().to_vec(),
        private_key: sk.as_slice().to_vec(),
    })
}

/// Generate ML-DSA (Dilithium3) keypair for post-quantum signatures.
fn generate_ml_dsa_keypair() -> StdResult<PQCKeypair, FString> {
    let (pk, sk) = dilithium3::keypair();

    Ok(PQCKeypair {
        public_key: pk.as_slice().to_vec(),
        private_key: sk.as_slice().to_vec(),
    })
}

/// ECDSA P-256 signature over a message.
fn ecdsa_sign(message: &[u8], sk: &[u8]) -> StdResult<FVec<u8>, FString> {
    let key_pair = signature::KeyPair::from_pkcs8(&ECDSA_P256_SHA256_FIXED, sk)
        .map_err(|e| format!("ECDSA keypair parse failed: {:?}", e))?;

    let rng = rand::SystemRandom::new();
    let sig = key_pair.sign(&rng, message)
        .map_err(|e| format!("ECDSA signing failed: {:?}", e))?;

    Ok(sig.as_ref().to_vec())
}

/// Verify ECDSA P-256 signature.
fn ecdsa_verify(message: &[u8], sig: &[u8], pk: &[u8]) -> StdResult<FBool, FString> {
    let unparsed_pk = signature::UnparsedPublicKey::new(&ECDSA_P256_SHA256_FIXED, pk);

    match unparsed_pk.verify(message, sig) {
        Ok(()) => Ok(true),
        Err(_) => Ok(false),
    }
}

/// ML-DSA (Dilithium3) signature over a message.
fn ml_dsa_sign(message: &[u8], sk: &[u8]) -> StdResult<FVec<u8>, FString> {
    let sk_bytes: [u8; 4000] = sk[..4000].try_into()
        .map_err(|_| "Invalid ML-DSA secret key length")?;
    let secret_key = dilithium3::SecretKey::from(sk_bytes);

    let signed = dilithium3::detached_sign(message, &secret_key);
    Ok(signed.as_slice().to_vec())
}

/// Verify ML-DSA (Dilithium3) signature.
fn ml_dsa_verify(message: &[u8], sig: &[u8], pk: &[u8]) -> StdResult<FBool, FString> {
    let pk_bytes: [u8; 1952] = pk[..1952].try_into()
        .map_err(|_| "Invalid ML-DSA public key length")?;
    let public_key = dilithium3::PublicKey::from(pk_bytes);

    let sig_bytes: [u8; 3293] = sig[..3293].try_into()
        .map_err(|_| "Invalid ML-DSA signature length")?;
    let signature = dilithium3::DetachedSignature::from(sig_bytes);

    match dilithium3::verify_detached_signature(&signature, message, &public_key) {
        Ok(()) => Ok(true),
        Err(_) => Ok(false),
    }
}
