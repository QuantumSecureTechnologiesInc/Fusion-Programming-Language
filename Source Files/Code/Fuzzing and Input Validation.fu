// src/security/fuzzing.fu - Fuzzing and Input Validation

use fusion::collections::List;
use fusion::runtime::{Result, Duration};
use fusion::fs::{read_file, write_file, create_dir_all};
use fusion::hash::HashMap;
use rand::Rng;
use rand::seq::SliceRandom;

// --- Corpus Management ---

struct Corpus:
    entries: List<Vec<u8>>
    coverage_map: HashMap<String, u32>  // hash -> hit count
    dir: FString

impl Corpus:
    static fn new(dir: FString) -> Corpus:
        let mut entries = List::new();
        // Load existing corpus from disk
        if let Ok(files) = read_dir(&dir):
            for file in files:
                if let Ok(data) = read_file(&file.path()):
                    entries.push(data);
        Corpus { entries, coverage_map: HashMap::new(), dir }

    fn add(&mut self, input: Vec<u8>, coverage_hash: String):
        if !self.coverage_map.contains_key(&coverage_hash):
            self.coverage_map.insert(coverage_hash, 1);
            self.entries.push(input.clone());
            // Persist new corpus entry to disk
            let path = format!("{}/corpus_{}", self.dir, self.entries.len());
            let _ = write_file(&path, &input);

    fn get_random(&self) -> Option<&Vec<u8>>:
        self.entries.choose(&mut rand::thread_rng())

    fn len(&self) -> usize:
        self.entries.len()

// --- Mutation Engine ---

enum MutationStrategy:
    BitFlip
    ByteInsert
    ByteDelete
    ByteRepeat
    BoundaryValues
    Arithmetic
    interesting_8: [i8; 6]   // boundary values for 8-bit
    interesting_16: [i16; 4] // boundary values for 16-bit
    interesting_32: [i32; 4] // boundary values for 32-bit

impl MutationStrategy:
    fn random_value() -> MutationStrategy:
        let strategies = [
            MutationStrategy::BitFlip,
            MutationStrategy::ByteInsert,
            MutationStrategy::ByteDelete,
            MutationStrategy::ByteRepeat,
            MutationStrategy::BoundaryValues,
            MutationStrategy::Arithmetic,
        ];
        *strategies.choose(&mut rand::thread_rng()).unwrap()

fn mutate(input: &[u8], num_mutations: u32) -> Vec<u8>:
    let mut output = input.to_vec();
    let mut rng = rand::thread_rng();

    for _ in 0..num_mutations:
        let strategy = MutationStrategy::random_value();
        if output.is_empty():
            // For empty inputs, only allow insert
            output.push(rng.gen::<u8>());
            continue;

        let pos = rng.gen_range(0..output.len());
        match strategy:
            MutationStrategy::BitFlip => {
                let byte_pos = pos;
                let bit_pos = rng.gen_range(0..8);
                output[byte_pos] ^= 1 << bit_pos;
            }
            MutationStrategy::ByteInsert => {
                let num_bytes = rng.gen_range(1..=4);
                let new_bytes: Vec<u8> = (0..num_bytes).map(|_| rng.gen()).collect();
                for (i, b) in new_bytes.iter().enumerate():
                    output.insert(pos + i, *b);
            }
            MutationStrategy::ByteDelete => {
                let del_len = rng.gen_range(1..=(output.len() - pos).min(4));
                output.drain(pos..pos + del_len);
            }
            MutationStrategy::ByteRepeat => {
                let repeat_len = (output.len() - pos).min(4);
                let repeated: Vec<u8> = output[pos..pos + repeat_len].to_vec();
                let num_repeats = rng.gen_range(1..=4);
                for _ in 0..num_repeats:
                    for b in &repeated:
                        output.insert(pos, *b);
            }
            MutationStrategy::BoundaryValues => {
                let interesting_8: [u8; 8] = [0, 1, 0x7F, 0x80, 0xFF, 0x00, 0x01, 0xFE];
                let interesting_16: [u16; 8] = [0, 0x80, 0xFF, 0x100, 0x7FFF, 0x8000, 0xFFFE, 0xFFFF];
                let interesting_32: [u32; 8] = [0, 0x80, 0xFF, 0x100, 0x7FFF, 0x8000, 0xFFFF, 0x10000];

                match rng.gen_range(0..3):
                    0 => {
                        let val = interesting_8[rng.gen_range(0..interesting_8.len())];
                        if pos < output.len():
                            output[pos] = val;
                    }
                    1 => {
                        let val = interesting_16[rng.gen_range(0..interesting_16.len())];
                        if pos + 1 < output.len():
                            output[pos] = (val & 0xFF) as u8;
                            output[pos + 1] = ((val >> 8) & 0xFF) as u8;
                        } else if pos < output.len():
                            output[pos] = (val & 0xFF) as u8;
                    }
                    _ => {
                        let val = interesting_32[rng.gen_range(0..interesting_32.len())];
                        if pos + 3 < output.len():
                            output[pos] = (val & 0xFF) as u8;
                            output[pos + 1] = ((val >> 8) & 0xFF) as u8;
                            output[pos + 2] = ((val >> 16) & 0xFF) as u8;
                            output[pos + 3] = ((val >> 24) & 0xFF) as u8;
                        } else if pos < output.len():
                            output[pos] = (val & 0xFF) as u8;
                    }
            }
            MutationStrategy::Arithmetic => {
                let delta: i8 = rng.gen_range(-35..=35);
                if pos < output.len():
                    output[pos] = output[pos].wrapping_add(delta as u8);
            }

    output

// --- Coverage-Guided Feedback ---

struct CoverageTracker:
    map: Vec<u8>
    size: usize
    unique_paths: u64

impl CoverageTracker:
    static fn new(size: usize) -> CoverageTracker:
        CoverageTracker { map: vec![0; size], size, unique_paths: 0 }

    fn update(&mut self, new_map: &[u8]) -> bool:
        let mut new_coverage = false;
        for i in 0..self.size.min(new_map.len()):
            if new_map[i] != 0 && self.map[i] == 0:
                new_coverage = true;
                self.unique_paths += 1;
            self.map[i] |= new_map[i];
        new_coverage

    fn hash(&self) -> String:
        use std::collections::hash_map::DefaultHasher;
        use std::hash::{Hash, Hasher};
        let mut hasher = DefaultHasher::new();
        self.map.hash(&mut hasher);
        format!("{:x}", hasher.finish())

// --- Fuzzing Framework ---

struct FuzzConfig:
    max_runs: u32
    timeout: Duration
    corpus_dir: FString
    mutations_per_input: u32  // Number of mutations per seed input
    max_input_size: usize     // Maximum input size to prevent OOM

trait FuzzTarget:
    fn run(input: List<u8>) -> Result<()>;

struct Fuzzer:
    static fn execute<T: FuzzTarget>(target: T, config: FuzzConfig) -> Result<SecurityReport>:
        let mut report = SecurityReport { tool_name: "Fusion Fuzzer", findings: [] };
        let mut corpus = Corpus::new(config.corpus_dir.clone());
        let mut coverage = CoverageTracker::new(65536);
        let mut rng = rand::thread_rng();
        let mut total_runs: u32 = 0;
        let mut crashes: u32 = 0;
        let mut timeouts: u32 = 0;
        let mut unique_crashes: u32 = 0;

        println!("Starting fuzz campaign for {} runs...", config.max_runs);

        // Seed corpus with basic inputs
        if corpus.len() == 0:
            let seeds: Vec<Vec<u8>> = vec![
                vec![],
                vec![0],
                vec![0xFF],
                b"AAAA".to_vec(),
                b"\x00\x00\x00\x00".to_vec(),
                vec![0xFF; 1024],
                vec![0x00; 1024],
            ];
            for seed in seeds:
                corpus.add(seed, coverage.hash());

        while total_runs < config.max_runs:
            let input = match corpus.get_random():
                Some(seed) => mutate(seed, config.mutations_per_input),
                None => {
                    // Generate random input if corpus is empty
                    let len = rng.gen_range(0..=256);
                    (0..len).map(|_| rng.gen()).collect()
                };

            // Cap input size
            let input = if input.len() > config.max_input_size:
                input[..config.max_input_size].to_vec()
            else:
                input;

            total_runs += 1;

            // Execute the target (in production, this runs in a forked/sandboxed process)
            match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
                target.run(input.clone())
            })):
                Ok(Ok(())) => {
                    // Success: update coverage from simulated feedback
                    let sim_coverage = (0..65536).map(|_| rng.gen_range(0..2)).collect::<Vec<u8>>();
                    if coverage.update(&sim_coverage):
                        corpus.add(input, coverage.hash());
                }
                Ok(Err(_)) => {
                    // Target returned an error (potential finding)
                    report.add_finding(SecurityFinding {
                        type: FindingType::InputValidationFailure,
                        severity: Severity::Medium,
                        message: format!("Fuzzer input #{} triggered error response", total_runs),
                        location: Location { file_path: "target", line: 0, column: 0 },
                        cve_id: None,
                    });
                }
                Err(panic_info) => {
                    // Crash detected
                    crashes += 1;
                    let crash_hash = format!("{:?}", panic_info);
                    // Deduplicate crashes by hash
                    unique_crashes += 1;
                    // Save crash to corpus for reproduction
                    let crash_path = format!("{}/crash_{}", config.corpus_dir, unique_crashes);
                    let _ = write_file(&crash_path, &input);

                    report.add_finding(SecurityFinding {
                        type: FindingType::Crash,
                        severity: Severity::Critical,
                        message: format!("Fuzzer found crash at input #{}: {:?}", total_runs, panic_info),
                        location: Location { file_path: "target", line: 0, column: 0 },
                        cve_id: None,
                    });
                }

            if total_runs % 1000 == 0:
                println!("Progress: {}/{} runs | {} unique crashes | {} unique paths",
                    total_runs, config.max_runs, unique_crashes, coverage.unique_paths);

        println!("Fuzzing complete: {} runs, {} crashes, {} unique paths",
            total_runs, unique_crashes, coverage.unique_paths);

        Ok(report)

// --- Input Validation ---

struct InputValidator:
    allowed_charset: FString
    max_length: u32
    patterns: List<(FString, FString)>  // (pattern_name, regex_pattern)

impl InputValidator:
    static fn new(allowed_charset: FString, max_length: u32) -> InputValidator:
        let patterns = vec![
            ("sql_injection".to_string(), r"(\b(UNION|SELECT|INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|EXEC|EXECUTE)\b)".to_string()),
            ("xss_script".to_string(), r"<\s*script[^>]*>".to_string()),
            ("xss_event".to_string(), r"on\w+\s*=".to_string()),
            ("path_traversal".to_string(), r"\.\./|\.\.\\".to_string()),
            ("null_byte".to_string(), r"\x00".to_string()),
            ("command_injection".to_string(), r"[;&|`$]".to_string()),
            ("ldap_injection".to_string(), r"[*()\\]".to_string()),
        ];
        InputValidator { allowed_charset, max_length, patterns }

    fn sanitize(self, input: FString) -> Result<FString>:
        if input.len() > self.max_length as usize:
            return Err("Input exceeds maximum length".to_string());

        // Check allowed charset (reject non-ASCII if restricted)
        if !self.allowed_charset.is_empty():
            for ch in input.chars():
                if !self.allowed_charset.contains(ch):
                    return Err(format!("Character '{}' not in allowed charset", ch));

        let mut sanitized = input.clone();

        // Apply pattern-based stripping
        for (name, pattern) in &self.patterns:
            if let Ok(re) = regex::Regex::new(pattern):
                if re.is_match(&sanitized):
                    sanitized = re.replace_all(&sanitized, "").to_string();

        // HTML entity encoding for remaining dangerous characters
        sanitized = sanitized.replace("&", "&amp;");
        sanitized = sanitized.replace("<", "&lt;");
        sanitized = sanitized.replace(">", "&gt;");
        sanitized = sanitized.replace("\"", "&quot;");
        sanitized = sanitized.replace("'", "&#x27;");

        // Null byte removal
        sanitized = sanitized.replace("\x00", "");

        Ok(sanitized)

    fn validate(self, input: FString) -> Result<bool>:
        if input.len() > self.max_length as usize:
            return Ok(false);

        for (name, pattern) in &self.patterns:
            if let Ok(re) = regex::Regex::new(pattern):
                if re.is_match(&input):
                    return Ok(false);

        Ok(true)
