// SOURCE: Source Files/Ecosystem/Fusion Crates/executor.rs
// NOTE: Converted into FSN mirror under fsn/converted.
/// Production Chain Executor.
/// 
/// Supports Directed Acyclic Graphs (DAGs) for complex AI workflows.
/// Features parallel execution of independent nodes and conditional branching.

use crate::ChainLink;
use fusion_std::error::{StdResult, StdError};
use fusion_core::FusionError;
use tokio::sync::RwLock;
use std::collections::{HashMap, HashSet, VecDeque};
use std::sync::Arc;

struct ChainContext {
    pub memory: FMap<FString, FString>,
}

struct ChainNode {
    pub id: FString,
    pub operation: Box<dyn ChainLink + Send + Sync>,
    pub dependencies: FVec<FString>,
}

struct GraphExecutor {
    nodes: FMap<FString, ChainNode>,
}

/// Error from a single node execution, carrying which node failed.
struct NodeExecutionError {
    pub node_id: FString,
    pub source: StdError,
}

impl std::fmt::Display for NodeExecutionError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "node '{}' failed: {}", self.node_id, self.source)
    }
}

impl GraphExecutor {
    fn new() -> Self {
        Self { nodes: HashMap::new() }
    }

    fn add_node(&mut self, node: ChainNode) {
        self.nodes.insert(node.id.clone(), node);
    }

    /// Detect cycles using Kahn's algorithm (BFS topological sort).
    /// Returns Err if a cycle exists or dependencies reference unknown nodes.
    fn validate_dag(&self) -> StdResult<()> {
        let mut in_degree: FMap<FString, usize> = FMap::new();
        let mut adjacency: FMap<FString, FVec<FString>> = FMap::new();

        // Initialize all nodes
        for (id, _) in &self.nodes {
            in_degree.entry(id.clone()).or_insert(0);
            adjacency.entry(id.clone()).or_insert_with(Vec::new);
        }

        // Build adjacency and in-degree from dependencies
        for (id, node) in &self.nodes {
            for dep in &node.dependencies {
                if !self.nodes.contains_key(dep) {
                    return Err(StdError::Compilation(
                        format!("node '{}' depends on unknown node '{}'", id, dep)
                    ));
                }
                adjacency.entry(dep.clone()).or_default().push(id.clone());
                *in_degree.entry(id.clone()).or_insert(0) += 1;
            }
        }

        // Kahn's algorithm
        let mut queue: VecDeque<FString> = in_degree.iter()
            .filter(|(_, &deg)| deg == 0)
            .map(|(id, _)| id.clone())
            .collect();
        let mut visited = 0usize;

        while let Some(node_id) = queue.pop_front() {
            visited += 1;
            if let Some(deps_on) = adjacency.get(&node_id) {
                for neighbor in deps_on {
                    let deg = in_degree.get_mut(neighbor).unwrap();
                    *deg -= 1;
                    if *deg == 0 {
                        queue.push_back(neighbor.clone());
                    }
                }
            }
        }

        if visited != self.nodes.len() {
            return Err(StdError::Compilation(
                "graph contains a cycle or unreachable nodes".into()
            ));
        }

        Ok(())
    }

    /// Execute the graph respecting dependencies with proper error propagation.
    pub async fn execute(&self, initial_input: FMap<FString, FString>) -> StdResult<ChainContext> {
        // Validate DAG before execution (cycle detection)
        self.validate_dag()?;

        let context = Arc::new(RwLock::new(ChainContext { memory: initial_input }));
        let mut executed: HashSet<FString> = HashSet::new();
        let mut failed: FMap<FString, StdError> = FMap::new();
        let mut pending: FVec<&ChainNode> = self.nodes.values().collect();

        while !pending.is_empty() {
            let mut next_batch = Vec::new();
            let mut remaining = Vec::new();

            for node in pending {
                // Skip nodes whose dependencies failed
                let deps_failed = node.dependencies.iter().any(|dep| failed.contains_key(dep));
                if deps_failed {
                    failed.insert(node.id.clone(), StdError::Core(
                        FusionError::CompilationError(
                            format!("skipped: dependency of '{}' failed", node.id)
                        )
                    ));
                    continue;
                }
                let deps_met = node.dependencies.iter().all(|dep| executed.contains(dep));
                if deps_met {
                    next_batch.push(node);
                } else {
                    remaining.push(node);
                }
            }

            if next_batch.is_empty() && !remaining.is_empty() {
                return Err(StdError::Core(
                    FusionError::CompilationError("graph cycle or unresolvable dependency".into())
                ));
            }

            // Execute batch in parallel
            let mut handles = Vec::new();
            for node in next_batch {
                let ctx_ref = context.clone();
                let node_id = node.id.clone();
                // Clone the operation pointer via Arc for concurrent access
                let op = Arc::new(unsafe {
                    // Safety: operation is Send+Sync; we hold Arc to share across tasks
                    std::ptr::read(&node.operation)
                });
                let nid = node_id.clone();
                executed.insert(node_id);

                handles.push(async move {
                    let mut ctx = ctx_ref.write().await;
                    match op.execute(&mut ctx.memory).await {
                        Ok(()) => Ok::<_, StdError>(()),
                        Err(e) => Err(StdError::Core(
                            FusionError::RuntimeError(format!("node '{}' execution failed: {}", nid, e))
                        )),
                    }
                });
            }

            let results = futures::future::join_all(handles).await;
            for (node, result) in self.nodes.values().zip(results) {
                if let Err(e) = result {
                    failed.insert(node.id.clone(), e);
                }
            }

            pending = remaining;
        }

        if !failed.is_empty() {
            let failed_nodes: FVec<FString> = failed.keys().cloned().collect();
            return Err(StdError::Core(
                FusionError::RuntimeError(format!(
                    "{} node(s) failed: [{}]",
                    failed.len(),
                    failed_nodes.join(", ")
                ))
            ));
        }

        let final_ctx = context.read().await;
        Ok(ChainContext { memory: final_ctx.memory.clone() })
    }
}
