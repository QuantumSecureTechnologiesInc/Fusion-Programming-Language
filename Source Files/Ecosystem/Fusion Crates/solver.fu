// SOURCE: Source Files/Ecosystem/Fusion Crates/solver.rs
// NOTE: Converted into FSN mirror under fsn/converted.
/// Production PCA Solver.
/// 
/// Uses Power Iteration method to find the dominant eigenvalue/vector
/// of the covariance matrix. This is numerically stable and requires no LAPACK.

use fusion_core::types::tensor::{Matrix, Vector1D};
use fusion_core::traits::Numeric;
use fusion_core::FusionResult;

/// Power Iteration Algorithm.
/// Finds the dominant eigenvector of a square matrix A.
/// Uses Rayleigh quotient for eigenvalue: λ = (b^T A b) / (b^T b)
fn power_iteration(a: &Matrix<f64>, num_simulations: usize, tol: f64) -> FusionResult<(f64, Vector1D<f64>)> {
    let n = a.shape[0];
    assert_eq!(a.shape[0], a.shape[1], "Matrix must be square");

    // Random initial vector (Box-Muller for proper normal distribution approximation)
    let mut b_k = Vector1D::new(vec![1.0; n], [n])?;
    let norm0 = norm(&b_k);
    if norm0 < 1e-15 {
        return Err(StdError::Core(fusion_core::FusionError::CompilationError(
            "Zero vector cannot be normalized".into(),
        )));
    }
    scale_inplace(&mut b_k, 1.0 / norm0);

    let mut prev_eigenvalue = 0.0;

    for iter in 0..num_simulations {
        // b_{k+1} = A * b_k
        let mut b_k1_data = vec![0.0; n];
        for r in 0..n {
            let mut sum = 0.0;
            for c in 0..n {
                sum += a.get([r, c])? * b_k.get([c])?;
            }
            b_k1_data[r] = sum;
        }
        let mut b_k1 = Vector1D::new(b_k1_data, [n])?;

        // Normalize
        let norm_k1 = norm(&b_k1);
        if norm_k1 < 1e-15 {
            break;
        }
        scale_inplace(&mut b_k1, 1.0 / norm_k1);

        // Rayleigh quotient: λ = b_k^T A b_k (denominator = 1 since b_k is unit)
        let mut rayleigh = 0.0;
        let mut ab_data = vec![0.0; n];
        for r in 0..n {
            let mut sum = 0.0;
            for c in 0..n {
                sum += a.get([r, c])? * b_k.get([c])?;
            }
            ab_data[r] = sum;
        }
        for i in 0..n {
            rayleigh += b_k.get([i])? * ab_data[i];
        }

        // Convergence check: |λ_k - λ_{k-1}| < tol
        if iter > 0 && (rayleigh - prev_eigenvalue).abs() < tol {
            return Ok((rayleigh, b_k1));
        }
        prev_eigenvalue = rayleigh;
        b_k = b_k1;
    }

    // Final Rayleigh quotient on converged vector
    let mut final_rayleigh = 0.0;
    let mut ab_final = vec![0.0; n];
    for r in 0..n {
        let mut sum = 0.0;
        for c in 0..n {
            sum += a.get([r, c])? * b_k.get([c])?;
        }
        ab_final[r] = sum;
    }
    for i in 0..n {
        final_rayleigh += b_k.get([i])? * ab_final[i];
    }

    Ok((final_rayleigh, b_k))
}

fn norm(v: &Vector1D<f64>) -> f64 {
    let sum_sq: f64 = v.data.iter().map(|x| x * x).sum();
    sum_sq.sqrt()
}

/// In-place vector scaling. Mutates the data buffer directly.
fn scale_inplace(v: &mut Vector1D<f64>, s: f64) {
    for x in v.data.iter_mut() {
        *x *= s;
    }
}
