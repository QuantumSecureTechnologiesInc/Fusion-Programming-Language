// SOURCE: Source Files/Ecosystem/Fusion Crates/train.rs
// NOTE: Converted into FSN mirror under fsn/converted.
/// Production GAN Trainer.
/// 
/// Manages the adversarial training loop with proper gradient detachment,
/// loss tracking, and checkpointing.

use crate::{Generator, Discriminator};
use fusion_ai_core::{Variable, SGD, Layer}; // Reusing Core components
use fusion_core::types::tensor::{Matrix, Tensor};
use fusion_core::FusionResult;
use fusion_core::traits::Numeric;

struct GANTrainer {
    pub generator: Generator,
    pub discriminator: Discriminator,
    pub opt_g: SGD,
    pub opt_d: SGD,
    pub latent_dim: usize,
}

impl GANTrainer {
    fn new(
        generator: Generator, 
        discriminator: Discriminator, 
        latent_dim: usize, 
        lr: f64
    ) -> Self {
        // Collect parameters properly
        let params_g = generator.parameters();
        let params_d = discriminator.parameters();
        
        Self {
            generator,
            discriminator,
            opt_g: SGD::new(params_g, lr),
            opt_d: SGD::new(params_d, lr),
            latent_dim,
        }
    }

    /// Execute one training step.
    /// Returns (loss_g, loss_d)
    fn train_step(&mut self, real_data: &Matrix<f64>) -> FusionResult<(f64, f64)> {
        let batch_size = real_data.shape[0];

        // --- Train Discriminator ---
        self.opt_d.zero_grad();

        // 1. Real Data Loss: D(x) -> Should be 1
        let real_input = Variable::new(real_data.clone());
        let d_real = self.discriminator.forward(real_input);
        let loss_real = self.bce_loss(&d_real, 1.0)?;

        // 2. Fake Data Loss: D(G(z)) -> Should be 0
        let z = self.sample_latent(batch_size)?;
        let fake_data = self.generator.forward(z);
        // Detach: clone data so gradients stop at D's graph boundary
        let fake_data_detached = Variable::new(fake_data.data.clone());

        let d_fake = self.discriminator.forward(fake_data_detached);
        let loss_fake = self.bce_loss(&d_fake, 0.0)?;

        // Backward pass: trigger autodiff through D's computation graph
        let loss_d = loss_real + loss_fake;
        loss_d.backward()?;
        self.opt_d.step();

        // --- Train Generator ---
        self.opt_g.zero_grad();

        // 3. Generator Loss: D(G(z)) -> Should be 1 (fool the discriminator)
        // Re-forward through G->D with gradient tracking on G's params
        let z2 = self.sample_latent(batch_size)?;
        let fake_data2 = self.generator.forward(z2);
        let d_fake_g = self.discriminator.forward(fake_data2);
        let loss_g = self.bce_loss(&d_fake_g, 1.0)?;

        // Backward pass: gradients flow through D (frozen) into G
        loss_g.backward()?;
        self.opt_g.step();

        // Extract scalar loss values
        let l_g = loss_g.data.get([0, 0])?;
        let l_d = loss_d.data.get([0, 0])?;

        Ok((l_g, l_d))
    }

    fn sample_latent(&self, batch_size: usize) -> FusionResult<Variable> {
        // Box-Muller transform for proper normal distribution N(0,1)
        let total = batch_size * self.latent_dim;
        let mut data = Vec::with_capacity(total);
        let mut rng = rand::thread_rng();

        for _ in 0..total {
            // rejection sample to avoid log(0) edge case
            let u1: f64 = loop {
                let v = rng.gen_range(0.0..1.0);
                if v > 1e-10 { break v; }
            };
            let u2: f64 = rng.gen_range(0.0..1.0);
            let z = (-2.0 * u1.ln()).sqrt() * (2.0 * std::f64::consts::PI * u2).cos();
            data.push(z);
        }

        let mat = Matrix::new(data, [batch_size, self.latent_dim])?;
        Ok(Variable::new(mat))
    }

    fn bce_loss(&self, pred: &Variable, target: f64) -> FusionResult<Variable> {
        // Binary Cross-Entropy: -[y*log(x) + (1-y)*log(1-x)]
        // Clamp predictions to avoid log(0) numerical instability
        let eps = 1e-7;
        let x = pred.data.get([0, 0])?.clamp(eps, 1.0 - eps);
        let loss_val = -(target * x.ln() + (1.0 - target) * (1.0 - x).ln());
        let loss_mat = Matrix::new(vec![loss_val], [1, 1])?;
        Ok(Variable::new(loss_mat))
    }
}
