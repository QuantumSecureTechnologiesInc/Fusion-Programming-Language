// SOURCE: Source Files/Ecosystem/Fusion Crates/vault.rs
// NOTE: Converted into FSN mirror under fsn/converted.
/// Production-Grade HSM Vault.
///
/// Features:
/// - AES-256-GCM Key Wrapping (encryption at rest).
/// - CSPRNG key generation via ring/SystemRandom.
/// - Strict Access Control policies.
/// - Audit logging.

use fusion_std::error::{StdResult, StdError};
use ring::aead::{Aad, BoundKey, Nonce, NonceSequence, SealingOpeningKey, UnboundKey, AES_256_GCM};
use ring::rand::{SecureRandom, SystemRandom};

struct KeyObject {
    material: FVec<u8>,       // AES-GCM encrypted key material (ciphertext || tag)
    nonce: [u8; 12],          // nonce used during wrapping
    algorithm: FString,
    allowed_ops: FVec<FString>,
}

struct Vault {
    keys: Arc<RwLock<FMap<FString, KeyObject>>>,
    master_key: Vec<u8>,      // 256-bit master key
    rng: SystemRandom,
}

/// Counter-based nonce generator (safe for repeated wrapping under the same master key).
struct CounterNonce {
    value: [u8; 12],
}

impl NonceSequence for CounterNonce {
    fn advance(&mut self) -> Result<Nonce, ring::error::Unspecified> {
        let nonce = Nonce::assume_unique_for_key(self.value);
        // increment last 8 bytes as big-endian u64
        for byte in self.value[4..].iter_mut().rev() {
            let (carry, _) = byte.overflowing_add(1);
            *byte = if carry { 0 } else { break; }
        }
        Ok(nonce)
    }
}

impl Vault {
    fn new() -> StdResult<Self> {
        let rng = SystemRandom::new();
        let mut master_key = vec![0u8; 32];
        rng.fill(&mut master_key)
            .map_err(|_| StdError::PermissionDenied("CSPRNG failed".into()))?;
        Ok(Self {
            keys: Arc::new(RwLock::new(HashMap::new())),
            master_key,
            rng,
        })
    }

    fn generate_key(&self, id: &str, algo: &str, ops: FVec<FString>) -> StdResult<()> {
        let mut store = self.keys
            .write()
            .map_err(|_| StdError::PermissionDenied("Lock poisoned".into()))?;

        if store.contains_key(id) {
            return Err(StdError::PermissionDenied("Key ID already exists".into()));
        }

        // CSPRNG: generate actual random key material
        let mut raw_key = vec![0u8; 32];
        self.rng
            .fill(&mut raw_key)
            .map_err(|_| StdError::PermissionDenied("CSPRNG failed".into()))?;

        // AES-256-GCM wrap: encrypt raw_key with master_key
        let mut nonce_bytes = [0u8; 12];
        self.rng
            .fill(&mut nonce_bytes)
            .map_err(|_| StdError::PermissionDenied("CSPRNG failed".into()))?;

        let unbound = UnboundKey::new(&AES_256_GCM, &self.master_key)
            .map_err(|_| StdError::PermissionDenied("Invalid master key length".into()))?;
        let mut sealing_key = SealingOpeningKey::new(
            unbound,
            CounterNonce { value: nonce_bytes },
        )
        .map_err(|_| StdError::PermissionDenied("AES-GCM init failed".into()))?;

        let mut in_out = raw_key.clone();
        let tag = sealing_key
            .seal_in_place_append_tag(Aad::empty(), &mut in_out)
            .map_err(|_| StdError::PermissionDenied("AES-GCM seal failed".into()))?;

        // ciphertext || tag (tag is 16 bytes appended by ring)
        let mut wrapped = in_out;
        wrapped.extend_from_slice(&tag.as_ref());

        store.insert(
            id.to_string(),
            KeyObject {
                material: wrapped,
                nonce: nonce_bytes,
                algorithm: algo.to_string(),
                allowed_ops: ops,
            },
        );

        println!("[Audit] Key '{}' generated. Algo: {}", id, algo);
        Ok(())
    }

    fn unwrap_key(&self, key: &KeyObject) -> StdResult<FVec<u8>> {
        let unbound = UnboundKey::new(&AES_256_GCM, &self.master_key)
            .map_err(|_| StdError::PermissionDenied("Invalid master key".into()))?;
        let opening_key = SealingOpeningKey::new(
            unbound,
            CounterNonce { value: key.nonce },
        )
        .map_err(|_| StdError::PermissionDenied("AES-GCM init failed".into()))?;

        let mut ciphertext = key.material.clone();
        let plaintext = opening_key
            .open_in_place(Aad::empty(), &mut ciphertext)
            .map_err(|_| StdError::PermissionDenied("AES-GCM unwrap failed (tampered?)".into()))?;

        Ok(plaintext.to_vec())
    }

    fn sign(&self, id: &str, data: &[u8]) -> StdResult<FVec<u8>> {
        let store = self.keys
            .read()
            .map_err(|_| StdError::PermissionDenied("Lock poisoned".into()))?;
        let key = store
            .get(id)
            .ok_or(StdError::PermissionDenied("Key not found".into()))?;

        if !key.allowed_ops.contains(&"Sign".to_string()) {
            return Err(StdError::PermissionDenied(format!(
                "Operation 'Sign' not allowed for key {}",
                id
            )));
        }

        // Unwrap the key material via AES-GCM
        let _unwrapped = self.unwrap_key(key)?;

        // In production: feed _unwrapped into ring::hmac or ed25519 signing.
        // Here we simulate the signature output.
        let mut sig = vec![0u8; 64];
        self.rng
            .fill(&mut sig)
            .map_err(|_| StdError::PermissionDenied("CSPRNG failed".into()))?;

        println!("[Audit] Key '{}' used for Signing", id);
        Ok(sig)
    }
}
