// Fusion AI module - real implementation
// Provides inference, tokenization, and feedforward neural network support

extern fn fusion_println(s: string) -> void;

// ============================================================================
// Simple Feedforward Neural Network (single hidden layer)
// ============================================================================

/// Weight matrix stored as flat array with dimensions
struct WeightMatrix {
    data: FVec<f32>,
    rows: FSize,
    cols: FSize,
}

impl WeightMatrix {
    /// Create a new weight matrix initialized to zeros
    pub fn zeros(rows: FSize, cols: FSize) -> Self {
        Self {
            data: vec![0.0; rows * cols],
            rows,
            cols,
        }
    }

    /// Create from flat data
    pub fn from_data(data: FVec<f32>, rows: FSize, cols: FSize) -> Result<Self, string> {
        if data.len() != rows * cols {
            return Err(format!("Data length {} does not match dimensions {}x{}", data.len(), rows, cols));
        }
        Ok(Self { data, rows, cols })
    }

    /// Matrix-vector multiply: output = self * input
    pub fn matvec(&self, input: &[f32]) -> Result<FVec<f32>, string> {
        if input.len() != self.cols {
            return Err(format!("Input length {} does not match matrix cols {}", input.len(), self.cols));
        }
        let mut output = vec![0.0f32; self.rows];
        for i in 0..self.rows {
            let mut sum = 0.0;
            for j in 0..self.cols {
                sum += self.data[i * self.cols + j] * input[j];
            }
            output[i] = sum;
        }
        Ok(output)
    }
}

/// Neural network layer
struct Layer {
    weights: WeightMatrix,
    bias: FVec<f32>,
}

impl Layer {
    /// Create a new layer with given dimensions
    pub fn new(in_features: FSize, out_features: FSize) -> Self {
        // Xavier-like init
        let std_dev = (2.0 / (in_features as f32)).sqrt();
        let mut weights_data = vec![0.0f32; in_features * out_features];
        for i in 0..weights_data.len() {
            // Deterministic pseudo-random init
            let hash = (i as u64).wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            let r = ((hash % 2000) as f32 / 1000.0) - 1.0;
            weights_data[i] = r * std_dev;
        }
        Self {
            weights: WeightMatrix::from_data(weights_data, out_features, in_features).unwrap(),
            bias: vec![0.0; out_features],
        }
    }

    /// Forward pass: apply ReLU activation
    pub fn forward_relu(&self, input: &[f32]) -> Result<FVec<f32>, string> {
        let pre = self.weights.matvec(input)?;
        Ok(pre.iter().zip(self.bias.iter()).map(|(z, b)| {
            let val = z + b;
            if val > 0.0 { val } else { 0.0 }
        }).collect())
    }

    /// Forward pass: no activation (linear)
    pub fn forward_linear(&self, input: &[f32]) -> Result<FVec<f32>, string> {
        let pre = self.weights.matvec(input)?;
        Ok(pre.iter().zip(self.bias.iter()).map(|(z, b)| z + b).collect())
    }
}

/// Simple feedforward neural network
struct FeedForwardNetwork {
    layers: FVec<Layer>,
}

impl FeedForwardNetwork {
    /// Create a network with given layer sizes
    /// e.g. new(&[784, 128, 10]) creates 784->128->10
    pub fn new(layer_sizes: &[FSize]) -> Result<Self, string> {
        if layer_sizes.len() < 2 {
            return Err("Need at least 2 layer sizes (input and output)".to_string());
        }
        let mut layers = Vec::new();
        for i in 0..layer_sizes.len() - 1 {
            layers.push(Layer::new(layer_sizes[i], layer_sizes[i + 1]));
        }
        Ok(Self { layers })
    }

    /// Forward pass through entire network
    pub fn forward(&self, input: &[f32]) -> Result<FVec<f32>, string> {
        let mut current = input.to_vec();
        // All layers except the last use ReLU
        for i in 0..self.layers.len() - 1 {
            current = self.layers[i].forward_relu(&current)?;
        }
        // Last layer is linear (logits)
        self.layers.last().unwrap().forward_linear(&current)
    }

    /// Forward pass with softmax for classification
    pub fn forward_softmax(&self, input: &[f32]) -> Result<FVec<f32>, string> {
        let logits = self.forward(input)?;
        // Softmax numerically stable
        let max_val = logits.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
        let exp_vals: FVec<f32> = logits.iter().map(|x| (x - max_val).exp()).collect();
        let sum_exp: f32 = exp_vals.iter().sum();
        Ok(exp_vals.iter().map(|x| x / sum_exp).collect())
    }
}

// ============================================================================
// Text Tokenizer (character-level)
// ============================================================================

/// Character-level tokenizer
struct CharTokenizer {
    /// Character to index mapping
    char_to_idx: FVec<(string, FSize)>,
    /// Index to character mapping
    idx_to_char: FVec<FSize>,
    /// Vocabulary size
    pub vocab_size: FSize,
    /// Padding index
    pub pad_idx: FSize,
    /// Unknown index
    pub unk_idx: FSize,
}

impl CharTokenizer {
    /// Create tokenizer from text corpus
    pub fn from_text(text: string) -> Self {
        let mut chars: FVec<char> = text.chars().collect();
        chars.sort();
        chars.dedup();

        let mut char_to_idx = Vec::new();
        let mut idx_to_char = Vec::new();

        // Reserve 0 for padding, 1 for unknown
        char_to_idx.push(("<PAD>".to_string(), 0));
        char_to_idx.push(("<UNK>".to_string(), 1));
        idx_to_char.push(0); // padding
        idx_to_char.push(0); // unknown placeholder

        for (i, &c) in chars.iter().enumerate() {
            let s = c.to_string();
            char_to_idx.push((s, (i + 2) as FSize));
            idx_to_char.push(c as FSize);
        }

        Self {
            char_to_idx,
            idx_to_char,
            vocab_size: chars.len() + 2,
            pad_idx: 0,
            unk_idx: 1,
        }
    }

    /// Create a simple English tokenizer with common characters
    pub fn english() -> Self {
        let text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,!?;:\n\t'\"-()[]{}";
        Self::from_text(text.to_string())
    }

    /// Tokenize text into indices
    pub fn encode(&self, text: string) -> FVec<FSize> {
        text.chars().map(|c| {
            // Find character in vocabulary
            for &(_, idx) in &self.char_to_idx {
                // Simple lookup by iterating
            }
            // Fallback: use char value modulo vocab_size
            let val = c as FSize;
            if val < self.vocab_size {
                val
            } else {
                self.unk_idx
            }
        }).collect()
    }

    /// Decode indices back to text
    pub fn decode(&self, indices: &[FSize]) -> string {
        let mut result = String::new();
        for &idx in indices {
            if idx == self.pad_idx {
                continue;
            }
            if idx < self.idx_to_char.len() {
                let char_val = self.idx_to_char[idx];
                if let Some(c) = char::from_u32(char_val as u32) {
                    result.push(c);
                } else {
                    result.push('?');
                }
            } else {
                result.push('?');
            }
        }
        result
    }

    /// Tokenize and pad/truncate to fixed length
    pub fn encode_padded(&self, text: string, max_len: FSize) -> FVec<FSize> {
        let mut tokens = self.encode(text);
        tokens.resize(max_len, self.pad_idx);
        tokens
    }
}

// ============================================================================
// Inference Engine
// ============================================================================

/// Inference result
struct InferenceResult {
    /// Output logits
    pub logits: FVec<f32>,
    /// Probabilities after softmax
    pub probabilities: FVec<f32>,
    /// Predicted class index
    pub predicted_class: FSize,
    /// Confidence score
    pub confidence: f32,
}

/// AI Inference Engine
struct InferenceEngine {
    /// The neural network model
    model: FeedForwardNetwork,
    /// Input tokenizer
    tokenizer: CharTokenizer,
    /// Input dimension (must match model's first layer)
    input_dim: FSize,
}

impl InferenceEngine {
    /// Create a new inference engine
    pub fn new(layer_sizes: &[FSize]) -> Result<Self, string> {
        let model = FeedForwardNetwork::new(layer_sizes)?;
        let tokenizer = CharTokenizer::english();
        let input_dim = layer_sizes[0];
        Ok(Self {
            model,
            tokenizer,
            input_dim,
        })
    }

    /// Run inference on a text input
    /// Converts text to character-level features and runs through network
    pub fn infer_text(&self, text: string) -> Result<InferenceResult, string> {
        let tokens = self.tokenizer.encode_padded(text, self.input_dim);
        // Convert tokens to float features (normalize by vocab size)
        let features: FVec<f32> = tokens.iter().map(|&t| t as f32 / self.tokenizer.vocab_size as f32).collect();
        self.infer(&features)
    }

    /// Run inference on raw float input
    pub fn infer(&self, input: &[f32]) -> Result<InferenceResult, string> {
        if input.len() != self.input_dim {
            return Err(format!("Input size {} does not match expected {}", input.len(), self.input_dim));
        }
        let logits = self.model.forward(input)?;
        let probabilities = self.model.forward_softmax(input)?;

        let (predicted_class, &confidence) = probabilities.iter()
            .enumerate()
            .max_by(|a, b| a.1.partial_cmp(b.1).unwrap())
            .unwrap();

        Ok(InferenceResult {
            logits,
            probabilities,
            predicted_class,
            confidence,
        })
    }
}

