      "",
      "fn ${1:secure_communication}(${2:key}: &[u8], ${3:data}: &[u8]) -> Vec<u8> {",
      "\tlet ciphertext = neuralseal_encrypt(${2:key}, ${3:data});",
      "\tneuralseal_decrypt(${2:key}, &ciphertext)",
      "}"
    ],
    "description": "NeuralSeal encrypt and decrypt"
