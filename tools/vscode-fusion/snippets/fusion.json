  "PQC Key Generation": {
    "prefix": "pqc keygen",
    "body": [
      "use quantum::pqc::{dilithium_keygen, kyber_keygen};",
      "",
      "fn ${1:generate_keys}() {",
      "\t// Dilithium signing keys",
      "\tlet (${2:dilithium_pk}, ${3:dilithium_sk}) = dilithium_keygen();",
      "",
      "\t// Kyber encapsulation keys",
      "\tlet (${4:kyber_pk}, ${5:kyber_sk}) = kyber_keygen();",
