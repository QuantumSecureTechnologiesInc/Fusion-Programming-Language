  "AI Model Training": {
    "prefix": "ai train",
    "body": [
      "use tensor::{zeros, relu, softmax, cross_entropy};",
      "use autodiff::{grad, enable_grad};",
      "",
      "model ${1:classifier} {",
      "\tlinear(${2:input_dim}, ${3:128}) -> relu -> linear(${3:128}, ${4:10}) -> softmax",
      "}",
      "",
      "fn ${5:train_model}(${6:data}: Dataset) {",
      "\tenable_grad();",
      "\tlet mut model = ${1:classifier};",
      "\tlet mut optimizer = adam(model.parameters(), lr=0.001);",
      "",
      "\tfor epoch in 0..${7:100} {",
      "\t\tlet predictions = forward(&model, &${6:data}.inputs);",
      "\t\tlet loss = cross_entropy(&predictions, &${6:data}.labels);",
      "\t\tbackward(&loss);",
      "\t\toptimizer.step();",
      "\t}",
      "}"
    ],
    "description": "Define and train an AI model"
  },
