  "Dilithium Sign & Verify": {
    "prefix": "dilithium sign",
    "body": [
      "use quantum::pqc::{dilithium_keygen, dilithium_sign, dilithium_verify};",
      "",
      "fn ${1:sign_and_verify}(${2:message}: &[u8]) -> bool {",
      "\tlet (pk, sk) = dilithium_keygen();",
      "\tlet signature = dilithium_sign(&sk, ${2:message});",
      "\tdilithium_verify(&pk, ${2:message}, &signature)",
      "}"
    ],
    "description": "Dilithium sign and verify workflow"
  },
  "NeuralSeal Encrypt/Decrypt": {
    "prefix": "neuralseal",
