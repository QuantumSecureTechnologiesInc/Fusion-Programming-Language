        let client = http::Client::new()
        let resp = client
            .post("{api_url}/api/generate")
            .json(payload)
            .send()
        let body = resp.json()
        body["response"].unwrap_or("")
    } else {
        let payload = {
            "model": resolved_model,
            "messages": [{"role": "user", "content": prompt}],
        }
        let client = http::Client::new()
