import fusion::io
import fusion::fs
import fusion::toml
import fusion::cmd
import fusion::http
import fusion::input

use crate::config::FusionConfig

const OLLAMA_API: String = "http://localhost:11434"

/// Read AI configuration from Fusion.toml [ai] section
fn read_ai_config(config: FusionConfig) -> Dict {
    let ai_config = {}

    if let Some(ai) = config["ai"] {
        if let Some(provider) = ai["provider"] {
            ai_config["provider"] = provider
        }
        if let Some(device) = ai["default_device"] {
            ai_config["default_device"] = device
        }
        // Read Ollama-specific config from [ai.ollama]
        if let Some(ollama) = ai["ollama"] {
            ai_config["ollama"] = ollama
        }
        // Read Mistral-specific config from [ai.mistral]
        if let Some(mistral) = ai["mistral"] {
            ai_config["mistral"] = mistral
        }
        // Read DeepSeek-specific config from [ai.deepseek]
        if let Some(deepseek) = ai["deepseek"] {
            ai_config["deepseek"] = deepseek
        }
    }

    return ai_config
}

/// Read Ollama provider settings from [ai.ollama]
fn read_ollama_config(ai_config: Dict) -> Dict {
    let ollama_config = {}

    if let Some(ollama) = ai_config["ollama"] {
        if let Some(api_url) = ollama["api_url"] {
            ollama_config["api_url"] = api_url
        }
        if let Some(model) = ollama["default_model"] {
            ollama_config["default_model"] = model
        }
        if let Some(timeout) = ollama["timeout"] {
            ollama_config["timeout"] = timeout
        }
        if let Some(num_ctx) = ollama["num_ctx"] {
            ollama_config["num_ctx"] = num_ctx
        }
    }

    return ollama_config
}

/// Read Mistral provider settings from [ai.mistral]
fn read_mistral_config(ai_config: Dict) -> Dict {
    let mistral_config = {}

    if let Some(mistral) = ai_config["mistral"] {
        if let Some(api_url) = mistral["api_url"] {
            mistral_config["api_url"] = api_url
        }
        if let Some(model) = mistral["default_model"] {
            mistral_config["default_model"] = model
        }
        if let Some(api_key_env) = mistral["api_key_env"] {
            mistral_config["api_key_env"] = api_key_env
        }
        if let Some(max_tokens) = mistral["max_tokens"] {
            mistral_config["max_tokens"] = max_tokens
        }
    }

    return mistral_config
}

/// Read DeepSeek provider settings from [ai.deepseek]
fn read_deepseek_config(ai_config: Dict) -> Dict {
    let deepseek_config = {}

    if let Some(deepseek) = ai_config["deepseek"] {
        if let Some(api_url) = deepseek["api_url"] {
            deepseek_config["api_url"] = api_url
        }
        if let Some(model) = deepseek["default_model"] {
            deepseek_config["default_model"] = model
        }
        if let Some(api_key_env) = deepseek["api_key_env"] {
            deepseek_config["api_key_env"] = api_key_env
        }
        if let Some(max_tokens) = deepseek["max_tokens"] {
            deepseek_config["max_tokens"] = max_tokens
        }
    }

    return deepseek_config
}

/// Get the API URL for the configured provider
fn get_provider_api_url(ai_config: Dict) -> String {
    let provider = ai_config.get("provider").unwrap_or("ollama")

    if provider == "ollama" {
        let ollama_config = read_ollama_config(ai_config)
        return ollama_config.get("api_url").unwrap_or(OLLAMA_API)
    } else if provider == "mistral" {
        let mistral_config = read_mistral_config(ai_config)
        return mistral_config.get("api_url").unwrap_or("https://api.mistral.ai/v1")
    } else if provider == "deepseek" {
        let deepseek_config = read_deepseek_config(ai_config)
        return deepseek_config.get("api_url").unwrap_or("https://api.deepseek.com/v1")
    }

    return OLLAMA_API
}

/// Get the default model for the configured provider
fn get_default_model(ai_config: Dict) -> String {
    let provider = ai_config.get("provider").unwrap_or("ollama")

    if provider == "ollama" {
        let ollama_config = read_ollama_config(ai_config)
        return ollama_config.get("default_model").unwrap_or("llama3")
    } else if provider == "mistral" {
        let mistral_config = read_mistral_config(ai_config)
        return mistral_config.get("default_model").unwrap_or("mistral-large-latest")
    } else if provider == "deepseek" {
        let deepseek_config = read_deepseek_config(ai_config)
        return deepseek_config.get("default_model").unwrap_or("deepseek-chat")
    }

    return "llama3"
}

/// Interactive chat with an AI model
async fn chat(model: String, json: bool) -> Result {
    // Load Fusion.toml for AI provider configuration
    let config = FusionConfig::load().unwrap_or_default()
    let ai_config = read_ai_config(config)
    let api_url = get_provider_api_url(ai_config)
    let resolved_model = if model == "default" { get_default_model(ai_config) } else { model }

    io::println("Starting chat with {resolved_model} (type 'exit' to quit)")

    loop {
        let user_input = input::Input::new()
            .with_prompt("you")
            .allow_empty(true)
            .interact_text()

        if user_input.trim().len() == 0 || user_input.trim() == "exit" {
            io::println("Chat ended.")
            break
        }

        let provider = ai_config.get("provider").unwrap_or("ollama")

        if provider == "ollama" {
            // Ollama API: /api/generate
            let payload = {
                "model": resolved_model,
                "prompt": user_input,
                "stream": false,
            }
            let client = http::Client::new()
            let resp = client
                .post("{api_url}/api/generate")
                .json(payload)
                .send()

            if !resp.status().is_success() {
                io::eprintln("error: Ollama returned status {resp.status()}")
                continue
            }

            let body = resp.json()
            let response = body["response"].unwrap_or("no response")
            io::println("{resolved_model}: {response}")
        } else if provider == "mistral" {
            // Mistral API: /chat/completions
            let payload = {
                "model": resolved_model,
                "messages": [{"role": "user", "content": user_input}],
            }
            let client = http::Client::new()
            let resp = client
                .post("{api_url}/chat/completions")
                .json(payload)
                .send()

            let body = resp.json()
            let response = body["choices"][0]["message"]["content"].unwrap_or("no response")
            io::println("{resolved_model}: {response}")
        } else if provider == "deepseek" {
            // DeepSeek API: /chat/completions
            let payload = {
                "model": resolved_model,
                "messages": [{"role": "user", "content": user_input}],
            }
            let client = http::Client::new()
            let resp = client
                .post("{api_url}/chat/completions")
                .json(payload)
                .send()

            let body = resp.json()
            let response = body["choices"][0]["message"]["content"].unwrap_or("no response")
            io::println("{resolved_model}: {response}")
        }
    }

    return Ok(())
}

/// Code completion
async fn complete(model: String, prompt: String, json: bool) -> Result {
    // Load Fusion.toml for AI provider configuration
    let config = FusionConfig::load().unwrap_or_default()
    let ai_config = read_ai_config(config)
    let api_url = get_provider_api_url(ai_config)
    let resolved_model = if model == "default" { get_default_model(ai_config) } else { model }

    let provider = ai_config.get("provider").unwrap_or("ollama")

    let response = if provider == "ollama" {
        let payload = {
            "model": resolved_model,
            "prompt": prompt,
            "stream": false,
        }
        let client = http::Client::new()
        let resp = client
            .post("{api_url}/api/generate")
            .json(payload)
            .send()
        let body = resp.json()
        body["response"].unwrap_or("")
    } else {
        let payload = {
            "model": resolved_model,
            "messages": [{"role": "user", "content": prompt}],
        }
        let client = http::Client::new()
        let resp = client
            .post("{api_url}/chat/completions")
            .json(payload)
            .send()
        let body = resp.json()
        body["choices"][0]["message"]["content"].unwrap_or("")
    }

    if json {
        io::println("{\"model\":\"{resolved_model}\",\"prompt\":\"{prompt}\",\"response\":\"{response}\"}")
    } else {
        io::println(response)
    }

    return Ok(())
}

/// Explain code in a file
async fn explain(file: String, json: bool) -> Result {
    let content = fs::read_to_string(file)

    // Load Fusion.toml for AI configuration
    let config = FusionConfig::load().unwrap_or_default()
    let ai_config = read_ai_config(config)
    let api_url = get_provider_api_url(ai_config)
    let resolved_model = get_default_model(ai_config)

    let prompt = "Explain this Fusion code in detail:\n\n{content}"
    let provider = ai_config.get("provider").unwrap_or("ollama")

    let response = if provider == "ollama" {
        let payload = {
            "model": resolved_model,
            "prompt": prompt,
            "stream": false,
        }
        let client = http::Client::new()
        let resp = client
            .post("{api_url}/api/generate")
            .json(payload)
            .send()
        let body = resp.json()
        body["response"].unwrap_or("")
    } else {
        let payload = {
            "model": resolved_model,
            "messages": [{"role": "user", "content": prompt}],
        }
        let client = http::Client::new()
        let resp = client
            .post("{api_url}/chat/completions")
            .json(payload)
            .send()
        let body = resp.json()
        body["choices"][0]["message"]["content"].unwrap_or("")
    }

    if json {
        io::println("{\"file\":\"{file}\",\"explanation\":\"{response}\"}")
    } else {
        io::println("Explanation: {file}")
        io::println(response)
    }

    return Ok(())
}

