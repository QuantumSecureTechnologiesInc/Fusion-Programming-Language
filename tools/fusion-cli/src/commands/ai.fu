/// Generate code from a description
async fn generate(description: String, json: bool) -> Result {
    // Load Fusion.toml for AI configuration
    let config = FusionConfig::load().unwrap_or_default()
    let ai_config = read_ai_config(config)
    let api_url = get_provider_api_url(ai_config)
    let resolved_model = get_default_model(ai_config)

    let prompt = "Generate Fusion code based on this description:\n\n{description}"
    let provider = ai_config.get("provider").unwrap_or("ollama")

    let response = if provider == "ollama" {
        let payload = {
            "model": resolved_model,
            "prompt": prompt,
            "stream": false,
        }
        let client = http::Client::new()
        let resp = client
            .post("{api_url}/api/generate")
            .json(payload)
            .send()
        let body = resp.json()
        body["response"].unwrap_or("")
    } else {
        let payload = {
            "model": resolved_model,
            "messages": [{"role": "user", "content": prompt}],
        }
        let client = http::Client::new()
        let resp = client
            .post("{api_url}/chat/completions")
            .json(payload)
            .send()
        let body = resp.json()
        body["choices"][0]["message"]["content"].unwrap_or("")
    }

    if json {
        io::println("{\"description\":\"{description}\",\"code\":\"{response}\"}")
    } else {
        io::println("Generated code:")
        io::println(response)
    }

    return Ok(())
}

/// List available AI models
async fn list_models(json: bool) -> Result {
    // Load Fusion.toml for AI provider configuration
    let config = FusionConfig::load().unwrap_or_default()
    let ai_config = read_ai_config(config)
    let provider = ai_config.get("provider").unwrap_or("ollama")

    if provider == "ollama" {
        let output = cmd::Command::new("ollama")
            .args(["list"])
            .output()

        let stdout = output.stdout

        if json {
            let models = stdout.lines().skip(1).filter(|l| l.trim().len() > 0).collect()
            io::println("{\"models\":{models}}")
        } else {
            io::println("ai: Available models (Ollama):")
            if stdout.trim().len() == 0 {
                io::println("  No models installed. Run `fusion ai pull <model>` to download one.")
            } else {
                io::println(stdout)
            }
        }
    } else {
        io::println("ai: Provider '{provider}' configured in Fusion.toml")
        if let Some(model) = ai_config.get("default_device") {
            io::println("  Default model: {model}")
        }
    }

    return Ok(())
}

/// Pull a model via Ollama
async fn pull(model: String, json: bool) -> Result {
    io::println("ai: Pulling model '{model}'...")

    let output = cmd::Command::new("ollama")
        .args(["pull", model])
        .stdin(cmd::Stdio::inherit())
        .stdout(cmd::Stdio::inherit())
        .stderr(cmd::Stdio::inherit())
        .status()

    if output.success() {
        if json {
            io::println("{\"model\":\"{model}\",\"status\":\"pulled\"}")
        } else {
            io::println("OK: Model '{model}' pulled successfully.")
        }
    } else {
        return Err("Failed to pull model '{model}'")
    }

    return Ok(())
}

/// Run the AI command
pub async fn run(command: AiCommands, json: bool) -> Result {
    match command {
        AiCommands::Chat { model } => chat(model, json).await,
        AiCommands::Complete { model, prompt } => complete(model, prompt, json).await,
        AiCommands::Explain { file } => explain(file, json).await,
        AiCommands::Review { file } => review(file, json).await,
        AiCommands::Generate { description } => generate(description.join(" "), json).await,
        AiCommands::Models => list_models(json).await,
        AiCommands::Pull { model } => pull(model, json).await,
    }
}
