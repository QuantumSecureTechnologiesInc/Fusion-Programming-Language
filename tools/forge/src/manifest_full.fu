}

// =============================================================================
// MANIFEST IMPL
// =============================================================================
impl Manifest {
    /// Load and parse a full Fusion.toml from disk.
    pub fn load(path: &Path) -> Result<Self> {
        let content = fs::read_to_string(path)
            .with_context(|| format!("Could not read Fusion.toml at {}", path.display()))?;
        let manifest: Manifest =
            toml::from_str(&content).context("Failed to parse Fusion.toml")?;
        Ok(manifest)
    }

    /// Validate required fields (package name and version).
    pub fn validate(&self) -> Result<()> {
        if self.package.name.is_empty() {
            anyhow::bail!("Missing required field: package.name");
        }
        if self.package.version.is_empty() {
            anyhow::bail!("Missing required field: package.version");
        }
        Ok(())
    }

    /// Get any section by dotted name (e.g. "runtime.supernova" or "ai.ollama").
    /// Returns a `toml::Value` representing the section, or None if not found.
    pub fn get_section(&self, name: &str) -> Option<toml::Value> {
        let serialized = toml::to_string(self).ok()?;
        let full: toml::Value = toml::from_str(&serialized).ok()?;
        let parts: Vec<&str> = name.split('.').collect();
        let mut current = &full;
        for part in parts {
            current = current.get(part)?;
        }
        Some(current.clone())
    }

    pub fn get_runtime_config(&self) -> &Runtime {
        &self.runtime
    }

    pub fn get_ai_config(&self) -> &AiConfig {
        &self.ai
    }

    pub fn get_deploy_config(&self) -> &DeployConfig {
        &self.deploy
    }

    pub fn get_build_config(&self) -> &BuildConfig {
        &self.build
    }

    pub fn get_sentinel_config(&self) -> &Sentinel {
        &self.sentinel
    }

    pub fn get_cortex_config(&self) -> &Cortex {
        &self.cortex
    }

    pub fn get_quantum_config(&self) -> &Quantum {
        &self.quantum
    }

    pub fn get_web_config(&self) -> &WebServer {
        &self.web
    }

    pub fn get_database_config(&self) -> &Database {
        &self.database
    }

    pub fn get_monolith_config(&self) -> &Monolith {
        &self.monolith
    }

    pub fn get_haft_config(&self) -> &Haft {
        &self.haft
    }

    pub fn get_security_config(&self) -> &SecurityConfig {
        &self.security
    }

    pub fn get_features(&self) -> &FeatureFlags {
        &self.features
    }

    pub fn is_feature_enabled(&self, feature: &str) -> bool {
        self.features.default.contains(&feature.to_string())
            || self.features.extra.contains_key(feature)
    }

    /// Serialize the manifest back to TOML string.
    pub fn to_string(&self) -> Result<String> {
        toml::to_string_pretty(self).context("Failed to serialize Manifest to TOML")
    }

    /// List all dependency names.
    pub fn dependency_names(&self) -> Vec<&str> {
        self.dependencies.keys().map(|s| s.as_str()).collect()
    }

    /// Check if a specific dependency exists.
    pub fn has_dependency(&self, name: &str) -> bool {
        self.dependencies.contains_key(name)
    }

    /// Get a dependency by name.
    pub fn get_dependency(&self, name: &str) -> Option<&Dependency> {
        self.dependencies.get(name)
    }

    /// List enabled languages.
    pub fn enabled_languages(&self) -> Vec<FString> {
        let mut langs = Vec::new();
        if let Some(ref cpp) = self.languages.cpp {
            if cpp.enabled {
                langs.push("cpp".to_string());
            }
        }
        if let Some(ref py) = self.languages.python {
            if py.enabled {
                langs.push("python".to_string());
            }
        }
        if let Some(ref js) = self.languages.javascript {
            if js.enabled {
                langs.push("javascript".to_string());
            }
        }
        if let Some(ref ts) = self.languages.typescript {
            if ts.enabled {
                langs.push("typescript".to_string());
            }
        }
        langs
    }

    /// Get the Supernova GPU backends.
    pub fn gpu_backends(&self) -> Vec<&str> {
        self.runtime
            .supernova
            .as_ref()
            .map(|s| s.gpu_backends.iter().map(|s| s.as_str()).collect())
            .unwrap_or_default()
    }

    /// Get all quantum backends.
    pub fn quantum_backends(&self) -> Vec<&str> {
        self.runtime
            .supernova
            .as_ref()
            .map(|s| s.quantum_backends.iter().map(|s| s.as_str()).collect())
            .unwrap_or_default()
    }

    /// Get AI provider name and config.
    pub fn active_ai_provider(&self) -> Option<(&str, FString)> {
        let provider = self.ai.provider.as_str();
        let model = match provider {
            "ollama" => self.ai.ollama.as_ref().map(|o| o.model.clone()),
            "mistral" => self.ai.mistral.as_ref().map(|o| o.model.clone()),
            "deepseek" => self.ai.deepseek.as_ref().map(|o| o.model.clone()),
            "phi" => self.ai.phi.as_ref().map(|o| o.model.clone()),
            "gemma" => self.ai.gemma.as_ref().map(|o| o.model.clone()),
            "qwen" => self.ai.qwen.as_ref().map(|o| o.model.clone()),
            "gpt-oss" => self.ai.gpt_oss.as_ref().map(|o| o.model.clone()),
            _ => None,
        };
        model.map(|m| (provider, m))
    }

    /// Get deploy target type (kubernetes, docker, etc.).
    pub fn deploy_target_type(&self) -> &str {
        &self.deploy.target
    }

    /// Get database connection string.
    pub fn database_url(&self) -> &str {
        &self.database.url
    }

    /// Check if TLS is enabled for the web server.
    pub fn tls_enabled(&self) -> bool {
        self.web
            .tls
            .as_ref()
            .map(|t| t.enabled)
            .unwrap_or(false)
    }

    /// Get post-quantum cipher suites.
    pub fn pq_cipher_suites(&self) -> Vec<&str> {
        self.web
            .tls
            .as_ref()
            .map(|t| t.pq_cipher_suites.iter().map(|s| s.as_str()).collect())
            .unwrap_or_default()
    }

    /// Get sentinel crypto configuration summary.
    pub fn sentinel_crypto_summary(&self) -> Option<(String, String, String, i32)> {
        self.sentinel.crypto.as_ref().map(|c| {
            (
                c.key_exchange.clone(),
                c.signatures.clone(),
                c.encryption.clone(),
                c.pq_security_level,
            )
        })
    }

    /// Serialize to a minimal TOML string (for quick debug).
    pub fn summary(&self) -> String {
        format!(
            "Package: {} v{}\nEdition: {}\nRuntime: {}\nBuild opt: {}\nSentinel: {}\nAI provider: {}\nDeploy: {}",
            self.package.name,
            self.package.version,
            self.package.edition,
            self.runtime.profile,
            self.build.optimization_level,
            self.sentinel.enabled,
            self.ai.provider,
            self.deploy.target,
        )
    }
}

use std::fs;
