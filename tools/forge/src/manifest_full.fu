use anyhow::{Context, Result};
use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use std::path::{Path, PathBuf};

type FMap<K, V> = HashMap<K, V>;
type FString = String;
type FVec<T> = Vec<T>;

// =============================================================================
// TOP-LEVEL MANIFEST
// =============================================================================
#[derive(Debug, Serialize, Deserialize, Clone)]
pub struct Manifest {
    #[serde(default)]
    pub package: Package,

    #[serde(default)]
    pub dependencies: FMap<FString, Dependency>,

    #[serde(default)]
    pub dev_dependencies: FMap<FString, Dependency>,

    #[serde(default)]
    pub build_dependencies: FMap<FString, Dependency>,

    #[serde(default)]
    pub workspace: Option<Workspace>,

    #[serde(default)]
    pub languages: Languages,

    #[serde(default)]
    pub lints: Lints,

    #[serde(default)]
    pub runtime: Runtime,

    #[serde(default)]
    pub build: BuildConfig,

    #[serde(default)]
    pub monolith: Monolith,

    #[serde(default)]
    pub haft: Haft,

    #[serde(default)]
    pub sentinel: Sentinel,

    #[serde(default)]
    pub cortex: Cortex,

    #[serde(default)]
    pub quantum: Quantum,

    #[serde(default)]
    pub ai: AiConfig,

    #[serde(default)]
    pub web: WebServer,

    #[serde(default)]
    pub database: Database,

    #[serde(default)]
    pub logging: Logging,

    #[serde(default)]
    pub telemetry: Telemetry,

    #[serde(default)]
    pub test: TestConfig,

    #[serde(default)]
    pub bench: BenchConfig,

    #[serde(default)]
    pub features: FeatureFlags,

    #[serde(default)]
    pub docs: DocsConfig,

    #[serde(default)]
    pub deploy: DeployConfig,

    #[serde(default)]
    pub security: SecurityConfig,

    #[serde(default)]
    pub scripts: Scripts,

    /// Catch-all for any unrecognized top-level sections.
    #[serde(flatten)]
    pub extra: FMap<FString, toml::Value>,
}

// =============================================================================
// PACKAGE
// =============================================================================
#[derive(Debug, Serialize, Deserialize, Clone, Default)]
pub struct Package {
    #[serde(default)]
    pub name: FString,

    #[serde(default)]
    pub version: FString,

    #[serde(default = "default_edition")]
    pub edition: FString,

    #[serde(default)]
    pub authors: FVec<FString>,

    #[serde(default)]
    pub description: FString,

    #[serde(default = "default_pkg_type")]
    pub pkg_type: FString,

    #[serde(default)]
    pub license: FString,

    #[serde(default)]
    pub repository: FString,

    #[serde(default)]
    pub homepage: FString,

    #[serde(default)]
    pub rust_version: FString,

    /// Catch-all for unexpected package fields.
    #[serde(flatten)]
    pub extra: FMap<FString, toml::Value>,
}

fn default_edition() -> FString {
    "2021".to_string()
}
fn default_pkg_type() -> FString {
    "library".to_string()
}

// =============================================================================
// DEPENDENCIES
// =============================================================================
#[derive(Debug, Serialize, Deserialize, Clone)]
#[serde(untagged)]
pub enum Dependency {
    Version(FString),
    Detailed(DependencyDetail),
}

#[derive(Debug, Serialize, Deserialize, Clone)]
pub struct DependencyDetail {
    #[serde(default)]
    pub version: Option<FString>,

    #[serde(default)]
    pub path: Option<FString>,

    #[serde(default)]
    pub git: Option<FString>,

    #[serde(default)]
    pub branch: Option<FString>,

    #[serde(default)]
    pub rev: Option<FString>,

    #[serde(default)]
    pub tag: Option<FString>,

    #[serde(default)]
    pub features: Option<FVec<FString>>,

    #[serde(default)]
    pub default_features: Option<bool>,

    #[serde(default)]
    pub workspace: Option<bool>,

    #[serde(default)]
    pub optional: Option<bool>,

    /// Catch-all for extra fields.
    #[serde(flatten)]
    pub extra: FMap<FString, toml::Value>,
}

impl Dependency {
    pub fn is_workspace(&self) -> bool {
        match self {
            Dependency::Detailed(d) => d.workspace.unwrap_or(false),
            _ => false,
        }
    }

    pub fn is_path(&self) -> bool {
        match self {
            Dependency::Detailed(d) => d.path.is_some(),
            _ => false,
        }
    }

    pub fn is_git(&self) -> bool {
        match self {
            Dependency::Detailed(d) => d.git.is_some(),
            _ => false,
        }
    }

    pub fn version_str(&self) -> Option<&str> {
        match self {
            Dependency::Version(v) => Some(v),
            Dependency::Detailed(d) => d.version.as_deref(),
        }
    }

    pub fn path_str(&self) -> Option<&str> {
        match self {
            Dependency::Detailed(d) => d.path.as_deref(),
            _ => None,
        }
    }
}

