// commands/crypto.fu — Post-quantum cryptography commands.
// keygen, sign, verify, encrypt, decrypt

fn cmd_crypto(args: CliArgs) -> void {
    let sub = args.subcommand;

    if str_eq(sub, "") {
        crypto_help();
        return;
    }

    if str_eq(sub, "keygen") {
        crypto_keygen(args);
    } else if str_eq(sub, "sign") {
        crypto_sign(args);
    } else if str_eq(sub, "verify") {
        crypto_verify(args);
    } else if str_eq(sub, "encrypt") {
        crypto_encrypt(args);
    } else if str_eq(sub, "decrypt") {
        crypto_decrypt(args);
    } else {
        print_error("Unknown crypto subcommand: ");
        puts(sub);
        crypto_help();
    }
}

fn crypto_help() -> void {
    print_bold("Fusion PQC Commands:");
    puts("  fusion crypto keygen [--algorithm <alg>]   Generate keypair");
    puts("  fusion crypto sign <file> --key <key>      Sign a file");
    puts("  fusion crypto verify <file> --sig <sig>    Verify a signature");
    puts("  fusion crypto encrypt <file> --pub <key>   Encrypt a file");
    puts("  fusion crypto decrypt <file> --key <key>   Decrypt a file");
}

fn crypto_keygen(args: CliArgs) -> void {
    let alg = "kyber";

    // Parse --algorithm flag
    if str_eq(args.arg1, "--algorithm") {
        if !str_eq(args.arg2, "") {
            alg = args.arg2;
        }
    }

    print_info("Generating PQC keypair (");
    print_info(alg);
    puts(")...");

    let cmd = "fuc.exe crypto keygen --algorithm ";
    cmd = cmd + alg;

    let status = run_command(cmd);

    if status == 0 {
        print_success("Keypair generated");
    } else {
        print_error("Keypair generation failed");
        exit(1);
    }
}

fn crypto_sign(args: CliArgs) -> void {
    let file = args.arg1;
    if str_eq(file, "") {
        print_error("Error: file required");
        puts("Usage: fusion crypto sign <file> --key <keyfile>");
        exit(1);
    }

    print_info("Signing: ");
    puts(file);

    let cmd = "fuc.exe crypto sign \"";
    cmd = cmd + file;
    cmd = cmd + "\"";

    if str_eq(args.arg2, "--key") {
        if !str_eq(args.arg3, "") {
            cmd = cmd + " --key \"";
            cmd = cmd + args.arg3;
            cmd = cmd + "\"";
        }
    }

    let status = run_command(cmd);

    if status == 0 {
        print_success("File signed");
    } else {
        print_error("Signing failed");
        exit(1);
    }
}

fn crypto_verify(args: CliArgs) -> void {
    let file = args.arg1;
    if str_eq(file, "") {
        print_error("Error: file required");
        puts("Usage: fusion crypto verify <file> --sig <sigfile>");
        exit(1);
    }

    print_info("Verifying: ");
    puts(file);

    let cmd = "fuc.exe crypto verify \"";
    cmd = cmd + file;
    cmd = cmd + "\"";

    if str_eq(args.arg2, "--sig") {
        if !str_eq(args.arg3, "") {
            cmd = cmd + " --sig \"";
            cmd = cmd + args.arg3;
            cmd = cmd + "\"";
        }
    }

    let status = run_command(cmd);

    if status == 0 {
        print_success("Signature valid");
    } else {
        print_error("Signature invalid");
        exit(1);
    }
}

