fn crypto_decrypt(args: CliArgs) -> void {
    let file = args.arg1;
    if str_eq(file, "") {
        print_error("Error: file required");
        puts("Usage: fusion crypto decrypt <file> --key <privkey>");
        exit(1);
    }

    print_info("Decrypting: ");
    puts(file);

    let cmd = "fuc.exe crypto decrypt \"";
    cmd = cmd + file;
    cmd = cmd + "\"";

    if str_eq(args.arg2, "--key") {
        if !str_eq(args.arg3, "") {
            cmd = cmd + " --key \"";
            cmd = cmd + args.arg3;
            cmd = cmd + "\"";
        }
    }

    let status = run_command(cmd);

    if status == 0 {
        print_success("File decrypted");
    } else {
        print_error("Decryption failed");
        exit(1);
    }
}
