    let file = args.arg1;
    if str_eq(file, "") {
        print_error("Error: file required");
        puts("Usage: fusion crypto encrypt <file> --pub <pubkey>");
        exit(1);
    }

    print_info("Encrypting: ");
    puts(file);

    let cmd = "fuc.exe crypto encrypt \"";
    cmd = cmd + file;
    cmd = cmd + "\"";

    if str_eq(args.arg2, "--pub") {
        if !str_eq(args.arg3, "") {
            cmd = cmd + " --pub \"";
            cmd = cmd + args.arg3;
            cmd = cmd + "\"";
        }
    }

    let status = run_command(cmd);

    if status == 0 {
        print_success("File encrypted");
