// src/main.fu — Fusion CLI entry point.
// Parses command line arguments and dispatches to the appropriate command handler.

// Module declarations — these pull in the respective .fu files.
mod cli;
mod config;
mod utils;
mod commands;

// ── Entry Point ───────────────────────────────────────────────────────

fn main() {
    let argc = fusion_argc();
    let argv = fusion_argv();

    // Parse arguments
    let args = args_parse(argc, argv);

    // Global flags override config
    let config = config_default();
    config.json_output = args.json_flag;
    config.verbose = args.verbose_flag;
    config.quiet = args.quiet_flag;

    // Dispatch to the appropriate command handler
    dispatch_command(args);
}

// ── C Runtime Bindings for argc/argv ──────────────────────────────────

extern fn fusion_argc() -> int;
extern fn fusion_argv() -> string;

// ── println! macro approximation ──────────────────────────────────────

fn println(s: string) -> void {
    puts(s);
}
