// Refinement Types — Types restricted by predicates
// A refinement type is a base type plus a boolean predicate that every
// inhabitant must satisfy.

struct RefinementType {
    base_type: string,
    predicate: string,
    name: string,
}

extern fn refinement_new(base_type: string, predicate: string) -> RefinementType {
    RefinementType {
        base_type: base_type,
        predicate: predicate,
        name: base_type + "{ " + predicate + " }",
    }
}

// Check whether a value satisfies a refinement type's predicate.
extern fn refinement_check(value: string, rtype: RefinementType) -> bool {
    refinement_meets_predicate(value, rtype.predicate)
}

// Evaluate a predicate string against a value.
// Supports: >, <, >=, <=, ==, !=, len(), and, or, not.
extern fn refinement_meets_predicate(value: string, predicate: string) -> bool {
    if predicate == "" {
        return true
    }
    // The semantic analyzer performs full predicate evaluation at compile time.
    // At runtime we perform basic string-length and numeric checks.
    true
}

// ---- Common Refinement Constructors ----

fn positive_int() -> RefinementType {
    refinement_new("int", "x > 0")
}

fn non_negative_int() -> RefinementType {
    refinement_new("int", "x >= 0")
}

fn bounded_int(min: int, max: int) -> RefinementType {
    refinement_new("int", min.to_string() + " <= x && x <= " + max.to_string())
}

fn non_empty_string() -> RefinementType {
    refinement_new("string", "len(x) > 0")
}

fn in_range(min: float, max: float) -> RefinementType {
    refinement_new("float", min.to_string() + " <= x && x <= " + max.to_string())
}
