// ---------------------------------------------------------------------------
// Transfers
// ---------------------------------------------------------------------------

/// Transfer `amount` of token `id` from `from` to `to`.
pub fn erc1155_transfer(token: Erc1155, from: string, to: string, id: int, amount: int) -> Erc1155 {
    // Real implementation would update balances for both accounts.
    token
}

/// Batch transfer multiple token types in a single transaction.
/// `ids` and `amounts` must be the same length.
pub fn erc1155_batch_transfer(token: Erc1155, from: string, to: string, ids: []int, amounts: []int) -> Erc1155 {
    let mut updated = token
    let i = 0
    while i < ids.len() {
        updated = erc1155_transfer(updated, from, to, ids[i], amounts[i])
        i += 1
    }
    updated
}

// ---------------------------------------------------------------------------
// Approvals
// ---------------------------------------------------------------------------

/// Grant or revoke operator approval for all token types.
pub fn erc1155_approve(token: Erc1155, owner: string, operator: string, approved: bool) -> Erc1155 {
    let entry = format!("\"{}\":{}", operator, if approved { "true" } else { "false" })
    let updated_approvals = format!(
        "{}",
        if token.approvals == "{}" {
            format!("{{\"{}\":{{{}}}}}", owner, entry)
        } else {
            token.approvals
        },
    )
    Erc1155 { approvals: updated_approvals, ..token }
}
