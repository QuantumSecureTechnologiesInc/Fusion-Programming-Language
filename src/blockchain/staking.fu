// Fusion v2.0 Vortex — Staking and Rewards

struct StakePool {
    total_staked: float
    reward_rate: float          // annual reward rate (e.g. 0.10 = 10%)
    lock_period: int            // default lock period in seconds
    stakes: []StakeRecord
}

struct StakeRecord {
    staker: string
    amount: float
    start_time: int
    end_time: int
    rewards: float
}

fn pool_stake(pool: StakePool, staker: string, amount: float, lock_period: int) -> StakePool {
    assert(amount > 0.0, "Stake amount must be positive")
    assert(len(staker) > 0, "Staker address must not be empty")

    let now = current_timestamp()
    let lock = if lock_period > 0 { lock_period } else { pool.lock_period }

    let record = StakeRecord {
        staker: staker,
        amount: amount,
        start_time: now,
        end_time: now + lock,
        rewards: 0.0
    }

    StakePool {
        ...pool,
        total_staked: pool.total_staked + amount,
        stakes: append(pool.stakes, record)
    }
}

fn pool_unstake(pool: StakePool, staker: string) -> (StakePool, float) {
    let now = current_timestamp()
    let mut found_amount = 0.0
    let new_stakes: []StakeRecord = []
    let mut new_total = pool.total_staked

    for s in pool.stakes {
        if s.staker == staker {
            assert(now >= s.end_time, "Lock period has not expired")
            found_amount = s.amount
            new_total = new_total - s.amount
        } else {
            new_stakes = append(new_stakes, s)
        }
    }

    assert(found_amount > 0.0, "No stake found for this address")

    let updated = StakePool {
        ...pool,
        total_staked: new_total,
        stakes: new_stakes
    }

    (updated, found_amount)
}

fn pool_claim_rewards(pool: StakePool, staker: string) -> (StakePool, float) {
    let now = current_timestamp()
    let mut claimable = 0.0
    let new_stakes: []StakeRecord = []

    for s in pool.stakes {
        if s.staker == staker {
            let elapsed = now - s.start_time
            let annual_reward = s.amount * pool.reward_rate
            let time_reward = annual_reward * to_float(elapsed) / to_float(365 * 24 * 3600)
            let total_reward = time_reward - s.rewards
            claimable = claimable + total_reward

            new_stakes = append(new_stakes, StakeRecord {
                ...s,
                rewards: s.rewards + total_reward
            })
        } else {
            new_stakes = append(new_stakes, s)
        }
    }

    assert(claimable > 0.0, "No rewards to claim")

    let updated = StakePool { ...pool, stakes: new_stakes }
    (updated, claimable)
}

fn pool_calculate_rewards(pool: StakePool, staker: string, current_time: int) -> float {
    let mut total = 0.0

    for s in pool.stakes {
        if s.staker == staker {
            let elapsed = current_time - s.start_time
            let annual_reward = s.amount * pool.reward_rate
            let time_reward = annual_reward * to_float(elapsed) / to_float(365 * 24 * 3600)
            total = total + (time_reward - s.rewards)
        }
    }

    total
}

fn pool_apy(pool: StakePool) -> float {
    pool.reward_rate * 100.0
}

fn pool_total_staked(pool: StakePool) -> float {
    pool.total_staked
}

fn pool_active_stakes(pool: StakePool) -> []StakeRecord {
    let now = current_timestamp()
    let active: []StakeRecord = []

    for s in pool.stakes {
        if now < s.end_time {
            active = append(active, s)
        }
    }

    active
}
