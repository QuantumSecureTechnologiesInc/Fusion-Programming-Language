// Fusion v2.0 Vortex — Merkle Tree
// Binary hash tree for efficient data integrity verification.

use crate::blockchain::crypto::{crypto_hash_sha256, crypto_merkle_root}

struct MerkleTree {
    root: string,
    leaves: []string,
    nodes: []string
}

/// Build a Merkle tree from raw data items.
/// Leaves are SHA-256 hashes of each data item.
fn merkle_new(data: []string) -> MerkleTree {
    let leaves: []string = []
    for item in data {
        leaves.push(crypto_hash_sha256(item))
    }

    // Build the full node list (all levels concatenated)
    let nodes: []string = []
    for leaf in leaves {
        nodes.push(leaf)
    }

    let level = leaves
    while level.len() > 1 {
        let next: []string = []
        let i = 0
        while i < level.len() {
            let combined: string
            if i + 1 < level.len() {
                combined = crypto_hash_sha256(level[i] + level[i + 1])
            } else {
                combined = level[i]
            }
            next.push(combined)
            nodes.push(combined)
            i += 2
        }
        level = next
    }

    let root = if nodes.len() > 0 { nodes[nodes.len() - 1] } else { crypto_hash_sha256("") }
    return MerkleTree { root, leaves, nodes }
}

/// Return the Merkle root hash.
fn merkle_root(tree: MerkleTree) -> string {
    return tree.root
}

/// Get the authentication proof path for the leaf at `index`.
/// Returns sibling hashes from leaf level up to (but not including) root.
fn merkle_proof(tree: MerkleTree, index: int) -> []string {
    let proof: []string = []
    let level = tree.leaves
    let idx = index

    while level.len() > 1 {
        let next: []string = []
        let i = 0
        let parent_idx = idx / 2
        let j = 0
        while i < level.len() {
            let sibling: string
            if i + 1 < level.len() {
                if i == idx {
                    sibling = level[i + 1]
                } else if i + 1 == idx {
                    sibling = level[i]
                } else {
                    sibling = ""
                }
                next.push(crypto_hash_sha256(level[i] + level[i + 1]))
            } else {
                if i == idx {
                    sibling = level[i]
                } else {
                    sibling = ""
                }
                next.push(level[i])
            }

            // Collect sibling for the path we're proving
            if i == idx || i + 1 == idx {
                if sibling != "" {
                    proof.push(sibling)
                }
            }

            i += 2
        }
        idx = parent_idx
        level = next
    }
    return proof
}

/// Verify a proof for the leaf at `index` against the known root.
fn merkle_verify(tree: MerkleTree, index: int, proof: []string) -> bool {
    if index < 0 || index >= tree.leaves.len() {
        return false
    }

    let hash = tree.leaves[index]
    let idx = index
    let current = hash

    let i = 0
    let result = current
    let pos = idx
    while i < proof.len() {
        let sibling = proof[i]
        let combined: string
        if pos % 2 == 0 {
            combined = crypto_hash_sha256(result + sibling)
        } else {
            combined = crypto_hash_sha256(sibling + result)
        }
        result = combined
        pos = pos / 2
        i += 1
    }

    return result == tree.root
}

/// Insert new data as a leaf and rebuild the tree.
fn merkle_insert(tree: MerkleTree, data: string) -> MerkleTree {
    let new_leaves = tree.leaves
    new_leaves.push(crypto_hash_sha256(data))
    return merkle_new_from_leaves(new_leaves)
}

/// Return the number of leaves in the tree.
fn merkle_size(tree: MerkleTree) -> int {
    return tree.leaves.len()
}

// Internal: rebuild tree from pre-hashed leaves
fn merkle_new_from_leaves(leaves: []string) -> MerkleTree {
    let nodes: []string = []
    for leaf in leaves {
        nodes.push(leaf)
    }

    let level = leaves
    while level.len() > 1 {
        let next: []string = []
        let i = 0
        while i < level.len() {
            let combined: string
            if i + 1 < level.len() {
                combined = crypto_hash_sha256(level[i] + level[i + 1])
            } else {
                combined = level[i]
            }
            next.push(combined)
            nodes.push(combined)
            i += 2
        }
        level = next
    }

    let root = if nodes.len() > 0 { nodes[nodes.len() - 1] } else { crypto_hash_sha256("") }
    return MerkleTree { root, leaves, nodes }
}
