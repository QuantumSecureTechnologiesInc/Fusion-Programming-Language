#![allow(dead_code)]
use super::Module;
use crate::ml::tensor::Tensor;
use crate::ml::MLError;

/// Sigmoid Activation: 1 / (1 + e^(-x))
struct Sigmoid;

impl Module for Sigmoid {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(sigmoid_forward(input))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// Tanh Activation: (e^x - e^(-x)) / (e^x + e^(-x))
struct Tanh;

impl Module for Tanh {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(tanh_forward(input))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// Leaky ReLU: max(alpha*x, x)
struct LeakyRelu {
    pub alpha: f32,
}

impl LeakyRelu {
    pub fn new(alpha: f32) -> Self {
        Self { alpha }
    }
}

impl Module for LeakyRelu {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(leaky_relu_forward(input, self.alpha))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// ELU: x if x > 0, alpha*(e^x - 1) if x <= 0
struct Elu {
    pub alpha: f32,
}

impl Elu {
    pub fn new(alpha: f32) -> Self {
        Self { alpha }
    }
}

impl Module for Elu {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(elu_forward(input, self.alpha))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// SELU: lambda * ELU(x, alpha)
struct Selu {
    pub alpha: f32,
    pub lambda: f32,
}

impl Selu {
    pub fn new() -> Self {
        Self {
            alpha: 1.6732632423543772848170429916717,
            lambda: 1.0507009873554804934193349852946,
        }
    }
}

impl Module for Selu {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(selu_forward(input, self.alpha, self.lambda))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// Mish: x * tanh(softplus(x))
struct Mish;

impl Module for Mish {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(mish_forward(input))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// Swish: x * sigmoid(x) (self-gated)
struct Swish {
    pub beta: f32,
}

impl Swish {
    pub fn new() -> Self {
        Self { beta: 1.0 }
    }
}

impl Module for Swish {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        Ok(swish_forward(input))
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// Softmax along a specific dimension
struct Softmax {
    pub dim: FSize,
}

impl Softmax {
    pub fn new(dim: FSize) -> Self {
        Self { dim }
    }
}

impl Module for Softmax {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        softmax_forward(input, self.dim as usize)
    }
    fn parameters(&self) -> FVec<&Tensor> {
        Vec::new()
    }
    fn train(&mut self, _mode: FBool) {}
}

/// Sigmoid forward: 1 / (1 + e^(-x))
fn sigmoid_forward(x: &Tensor) -> Tensor {
    x.map(|v| 1.0 / (1.0 + (-v).exp()))
}

/// Tanh forward: (e^x - e^(-x)) / (e^x + e^(-x))
fn tanh_forward(x: &Tensor) -> Tensor {
    x.map(|v| v.tanh())
}

/// Leaky ReLU forward: max(alpha*x, x)
fn leaky_relu_forward(x: &Tensor, alpha: f32) -> Tensor {
    x.map(|v| if v > 0.0 { v } else { alpha * v })
}

/// ELU forward: x if x > 0, alpha*(e^x - 1) if x <= 0
fn elu_forward(x: &Tensor, alpha: f32) -> Tensor {
    x.map(|v| if v > 0.0 { v } else { alpha * (v.exp() - 1.0) })
}

/// SELU forward: lambda * ELU(x, alpha)
fn selu_forward(x: &Tensor, alpha: f32, lambda: f32) -> Tensor {
    x.map(|v| {
        if v > 0.0 {
            lambda * v
        } else {
            lambda * alpha * (v.exp() - 1.0)
        }
    })
}

/// Mish forward: x * tanh(softplus(x))
/// softplus(x) = ln(1 + e^x)
fn mish_forward(x: &Tensor) -> Tensor {
    x.map(|v| {
        let softplus = (1.0 + v.exp()).ln();
        v * softplus.tanh()
    })
}

/// Swish forward: x * sigmoid(x)
fn swish_forward(x: &Tensor) -> Tensor {
    x.map(|v| v / (1.0 + (-v).exp()))
}

/// Softmax forward: numerically stable
fn softmax_forward(x: &Tensor, dim: usize) -> Result<Tensor, MLError> {
    x.softmax(dim)
}
