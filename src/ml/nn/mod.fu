use super::tensor::Tensor;
use super::MLError;

/// Neural Network Module Trait
pub trait Module {
    /// Forward pass
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError>;
    /// Get trainable parameters
    fn parameters(&self) -> FVec<&Tensor>;
    /// Set training mode
    fn train(&mut self, mode: FBool);
}

// Re-export key types from submodules
pub use layers::{Linear, ReLU, Sigmoid, Tanh, Dropout, BatchNorm, Sequential, HybridQuantumLayer};
pub use conv::{Conv1d, Conv2d};
pub use normalization::{BatchNorm1d, BatchNorm2d, LayerNorm, InstanceNorm, GroupNorm};
pub use container::{ModuleList, ModuleDict};
pub use activation::{LeakyRelu, Elu, Selu, Mish, Swish, Softmax};
pub use model_zoo::{LeNet5, ResNetBlock, ResNet18, VGG};
