use super::Module;
use crate::ml::tensor::Tensor;
use crate::ml::MLError;

/// Recurrent Neural Network (RNN) Cell
/// h_next = tanh(W_ih * x + W_hh * h_prev + b)
struct RnnCell {
    pub input_size: FSize,
    pub hidden_size: FSize,
    pub weights_ih: Tensor,
    pub weights_hh: Tensor,
    pub bias_ih: Option<Tensor>,
    pub bias_hh: Option<Tensor>,
    training: FBool,
}

impl RnnCell {
    pub fn new(input_size: FSize, hidden_size: FSize, bias: FBool) -> Self {
        let weights_ih = Self::xavier_init(input_size, hidden_size);
        let weights_hh = Self::xavier_init(hidden_size, hidden_size);
        let bias_ih = if bias {
            Some(Tensor::zeros(vec![1, hidden_size]))
        } else {
            None
        };
        let bias_hh = if bias {
            Some(Tensor::zeros(vec![1, hidden_size]))
        } else {
            None
        };
        Self {
            input_size,
            hidden_size,
            weights_ih,
            weights_hh,
            bias_ih,
            bias_hh,
            training: true,
        }
    }

    fn xavier_init(in_features: FSize, out_features: FSize) -> Tensor {
        let std = (2.0 / (in_features + out_features) as f32).sqrt();
        let data: FVec<f32> = (0..in_features * out_features)
            .map(|i| {
                let hash = (i as u64)
                    .wrapping_mul(6364136223846793005)
                    .wrapping_add(1442695040888963407);
                let u = (hash % 10000) as f32 / 10000.0;
                let u2 = ((hash >> 16) % 10000) as f32 / 10000.0;
                let z = (-2.0 * u.ln()).sqrt() * (2.0 * 3.14159265 * u2).cos();
                z * std
            })
            .collect();
        Tensor::new(data, vec![in_features, out_features]).unwrap()
    }

    pub fn forward_step(&self, x: &Tensor, h_prev: &Tensor) -> Result<Tensor, MLError> {
        let wh_x = x.matmul(&self.weights_ih)?;
        let hh_h = h_prev.matmul(&self.weights_hh)?;
        let mut output = wh_x.add(&hh_h)?;
        if let Some(ref b) = self.bias_ih {
            output = output.add(b)?;
        }
        if let Some(ref b) = self.bias_hh {
            output = output.add(b)?;
        }
        Ok(output.map(|v| v.tanh()))
    }

    pub fn forward_sequence(
        &self,
        input: &Tensor,
        h0: &Tensor,
    ) -> Result<Tensor, MLError> {
        let seq_len = input.shape()[0];
        let mut h = h0.clone();
        let mut outputs = Vec::new();
        for t in 0..seq_len {
            let x_t = Tensor::new(vec![input.get(&[t]).unwrap()], vec![1, self.input_size]).unwrap();
            h = self.forward_step(&x_t, &h)?;
            outputs.push(h.clone());
        }
        let mut all_data = Vec::new();
        for out in &outputs {
            all_data.extend(out.data().iter().cloned());
        }
        Tensor::new(all_data, vec![seq_len, self.hidden_size])
    }
}

impl Module for RnnCell {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        let batch_size = input.shape()[0];
        let h0 = Tensor::zeros(vec![batch_size, self.hidden_size]);
        let mut h = h0;
        let mut outputs = Vec::new();
        for b in 0..batch_size {
            let x_b = Tensor::new(
                input.data()[b * self.input_size..(b + 1) * self.input_size].to_vec(),
                vec![1, self.input_size],
            )
            .unwrap();
            h = self.forward_step(&x_b, &h)?;
            outputs.push(h.clone());
        }
        let mut all_data = Vec::new();
        for out in &outputs {
            all_data.extend(out.data().iter().cloned());
        }
        Tensor::new(all_data, vec![batch_size, self.hidden_size])
    }

    fn parameters(&self) -> FVec<&Tensor> {
        let mut params = vec![&self.weights_ih, &self.weights_hh];
        if let Some(ref b) = self.bias_ih {
            params.push(b);
        }
        if let Some(ref b) = self.bias_hh {
            params.push(b);
        }
        params
    }

    fn train(&mut self, mode: FBool) {
        self.training = mode;
    }
}

/// Long Short-Term Memory (LSTM) Cell
/// Gates: forget=sigmoid, input=sigmoid, candidate=tanh, output=sigmoid
struct LstmCell {
    pub input_size: FSize,
    pub hidden_size: FSize,
    pub weights_ih: Tensor,
    pub weights_hh: Tensor,
    pub bias_ih: Option<Tensor>,
    pub bias_hh: Option<Tensor>,
    training: FBool,
}

impl LstmCell {
    pub fn new(input_size: FSize, hidden_size: FSize, bias: FBool) -> Self {
        let weights_ih = Self::xavier_init(input_size, hidden_size * 4);
        let weights_hh = Self::xavier_init(hidden_size, hidden_size * 4);
        let bias_ih = if bias {
            Some(Tensor::zeros(vec![1, hidden_size * 4]))
        } else {
            None
        };
        let bias_hh = if bias {
            Some(Tensor::zeros(vec![1, hidden_size * 4]))
        } else {
            None
        };
        Self {
            input_size,
            hidden_size,
            weights_ih,
            weights_hh,
            bias_ih,
            bias_hh,
            training: true,
        }
    }

    fn xavier_init(in_features: FSize, out_features: FSize) -> Tensor {
        let std = (2.0 / (in_features + out_features) as f32).sqrt();
        let data: FVec<f32> = (0..in_features * out_features)
            .map(|i| {
                let hash = (i as u64)
                    .wrapping_mul(6364136223846793005)
                    .wrapping_add(1442695040888963407);
                let u = (hash % 10000) as f32 / 10000.0;
                let u2 = ((hash >> 16) % 10000) as f32 / 10000.0;
                let z = (-2.0 * u.ln()).sqrt() * (2.0 * 3.14159265 * u2).cos();
                z * std
            })
            .collect();
        Tensor::new(data, vec![in_features, out_features]).unwrap()
    }

    pub fn forward_step(
        &self,
        x: &Tensor,
        h_prev: &Tensor,
        c_prev: &Tensor,
    ) -> Result<(Tensor, Tensor), MLError> {
        let combined = x.matmul(&self.weights_ih)?.add(&h_prev.matmul(&self.weights_hh)?)?;
        let combined = if let Some(ref b) = self.bias_ih {
            combined.add(b)?
        } else {
            combined
        };
        let combined = if let Some(ref b) = self.bias_hh {
            combined.add(b)?
        } else {
            combined
        };
        let gates = combined.map(|v| v.sigmoid());
        let h_size = self.hidden_size;
        let forget = Tensor::new(
            gates.data()[0..h_size].to_vec(),
            vec![1, h_size],
        ).unwrap();
        let input = Tensor::new(
            gates.data()[h_size..2 * h_size].to_vec(),
            vec![1, h_size],
        ).unwrap();
        let candidate = Tensor::new(
            gates.data()[2 * h_size..3 * h_size].to_vec(),
            vec![1, h_size],
        ).unwrap();
        let output = Tensor::new(
            gates.data()[3 * h_size..4 * h_size].to_vec(),
            vec![1, h_size],
        ).unwrap();
        let candidate = candidate.map(|v| v.tanh());
        let c_next = forget
            .mul(c_prev)?
            .add(&input.mul(&candidate)?)?;
        let h_next = c_next.map(|v| v.tanh()).mul(&output)?;
        Ok((h_next, c_next))
    }

    pub fn forward_sequence(
        &self,
        input: &Tensor,
        h0: &Tensor,
        c0: &Tensor,
    ) -> Result<(Tensor, Tensor, Tensor), MLError> {
        let seq_len = input.shape()[0];
        let mut h = h0.clone();
        let mut c = c0.clone();
        let mut outputs = Vec::new();
        for t in 0..seq_len {
            let x_t = Tensor::new(vec![input.get(&[t]).unwrap()], vec![1, self.input_size]).unwrap();
            let (h_new, c_new) = self.forward_step(&x_t, &h, &c)?;
            h = h_new;
            c = c_new;
            outputs.push(h.clone());
        }
        let mut all_data = Vec::new();
        for out in &outputs {
            all_data.extend(out.data().iter().cloned());
        }
        let out_tensor = Tensor::new(all_data, vec![seq_len, self.hidden_size])?;
        Ok((out_tensor, h, c))
    }
}

impl Module for LstmCell {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        let batch_size = input.shape()[0];
        let h0 = Tensor::zeros(vec![batch_size, self.hidden_size]);
        let c0 = Tensor::zeros(vec![batch_size, self.hidden_size]);
        let mut h = h0;
        let mut c = c0;
        let mut outputs = Vec::new();
        for b in 0..batch_size {
            let x_b = Tensor::new(
                input.data()[b * self.input_size..(b + 1) * self.input_size].to_vec(),
                vec![1, self.input_size],
            ).unwrap();
            let (h_new, c_new) = self.forward_step(&x_b, &h, &c)?;
            h = h_new;
            c = c_new;
            outputs.push(h.clone());
        }
        let mut all_data = Vec::new();
        for out in &outputs {
            all_data.extend(out.data().iter().cloned());
        }
        Tensor::new(all_data, vec![batch_size, self.hidden_size])
    }

    fn parameters(&self) -> FVec<&Tensor> {
        let mut params = vec![&self.weights_ih, &self.weights_hh];
        if let Some(ref b) = self.bias_ih {
            params.push(b);
        }
        if let Some(ref b) = self.bias_hh {
            params.push(b);
        }
        params
    }

    fn train(&mut self, mode: FBool) {
        self.training = mode;
    }
}

/// Gated Recurrent Unit (GRU) Cell
/// Gates: reset=sigmoid, update=sigmoid, candidate=tanh
struct GruCell {
    pub input_size: FSize,
    pub hidden_size: FSize,
    pub weights_ih: Tensor,
    pub weights_hh: Tensor,
    pub bias_ih: Option<Tensor>,
    pub bias_hh: Option<Tensor>,
    training: FBool,
}

impl GruCell {
    pub fn new(input_size: FSize, hidden_size: FSize, bias: FBool) -> Self {
        let weights_ih = Self::xavier_init(input_size, hidden_size * 3);
        let weights_hh = Self::xavier_init(hidden_size, hidden_size * 3);
        let bias_ih = if bias {
            Some(Tensor::zeros(vec![1, hidden_size * 3]))
        } else {
            None
        };
        let bias_hh = if bias {
            Some(Tensor::zeros(vec![1, hidden_size * 3]))
        } else {
            None
        };
        Self {
            input_size,
            hidden_size,
            weights_ih,
            weights_hh,
            bias_ih,
            bias_hh,
            training: true,
        }
    }

    fn xavier_init(in_features: FSize, out_features: FSize) -> Tensor {
        let std = (2.0 / (in_features + out_features) as f32).sqrt();
        let data: FVec<f32> = (0..in_features * out_features)
            .map(|i| {
                let hash = (i as u64)
                    .wrapping_mul(6364136223846793005)
                    .wrapping_add(1442695040888963407);
                let u = (hash % 10000) as f32 / 10000.0;
                let u2 = ((hash >> 16) % 10000) as f32 / 10000.0;
                let z = (-2.0 * u.ln()).sqrt() * (2.0 * 3.14159265 * u2).cos();
                z * std
            })
            .collect();
        Tensor::new(data, vec![in_features, out_features]).unwrap()
    }

    pub fn forward_step(&self, x: &Tensor, h_prev: &Tensor) -> Result<Tensor, MLError> {
        let x_proj = x.matmul(&self.weights_ih)?;
        let h_proj = h_prev.matmul(&self.weights_hh)?;
        let x_proj = if let Some(ref b) = self.bias_ih {
            x_proj.add(b)?
        } else {
            x_proj
        };
        let h_proj = if let Some(ref b) = self.bias_hh {
            h_proj.add(b)?
        } else {
            h_proj
        };
        let x_gates = x_proj.map(|v| v.sigmoid());
        let reset_x = Tensor::new(
            x_gates.data()[0..self.hidden_size].to_vec(),
            vec![1, self.hidden_size],
        ).unwrap();
        let update_x = Tensor::new(
            x_gates.data()[self.hidden_size..2 * self.hidden_size].to_vec(),
            vec![1, self.hidden_size],
        ).unwrap();
        let candidate_x = Tensor::new(
            x_gates.data()[2 * self.hidden_size..3 * self.hidden_size].to_vec(),
            vec![1, self.hidden_size],
        ).unwrap();
        let reset = reset_x;
        let update = update_x;
        let reset_h = h_proj.mul(&reset)?;
        let candidate = candidate_x.add(&reset_h.matmul(&self.weights_hh)?)?;
        let candidate = candidate.map(|v| v.tanh());
        let h_next = update
            .mul(&candidate)?
            .add(&update.map(|v| 1.0 - v).mul(h_prev)?)?;
        Ok(h_next)
    }

    pub fn forward_sequence(
        &self,
        input: &Tensor,
        h0: &Tensor,
    ) -> Result<Tensor, MLError> {
        let seq_len = input.shape()[0];
        let mut h = h0.clone();
        let mut outputs = Vec::new();
        for t in 0..seq_len {
            let x_t = Tensor::new(vec![input.get(&[t]).unwrap()], vec![1, self.input_size]).unwrap();
            h = self.forward_step(&x_t, &h)?;
            outputs.push(h.clone());
        }
        let mut all_data = Vec::new();
        for out in &outputs {
            all_data.extend(out.data().iter().cloned());
        }
        Tensor::new(all_data, vec![seq_len, self.hidden_size])
    }
}

impl Module for GruCell {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        let batch_size = input.shape()[0];
        let h0 = Tensor::zeros(vec![batch_size, self.hidden_size]);
        let mut h = h0;
        let mut outputs = Vec::new();
        for b in 0..batch_size {
            let x_b = Tensor::new(
                input.data()[b * self.input_size..(b + 1) * self.input_size].to_vec(),
                vec![1, self.input_size],
            ).unwrap();
            h = self.forward_step(&x_b, &h)?;
            outputs.push(h.clone());
        }
        let mut all_data = Vec::new();
        for out in &outputs {
            all_data.extend(out.data().iter().cloned());
        }
        Tensor::new(all_data, vec![batch_size, self.hidden_size])
    }

    fn parameters(&self) -> FVec<&Tensor> {
        let mut params = vec![&self.weights_ih, &self.weights_hh];
        if let Some(ref b) = self.bias_ih {
            params.push(b);
        }
        if let Some(ref b) = self.bias_hh {
            params.push(b);
        }
        params
    }

    fn train(&mut self, mode: FBool) {
        self.training = mode;
    }
}

/// Bidirectional RNN wrapper
/// Processes input in both forward and backward directions
struct BidirectionalRnn {
    forward_cell: Box<dyn Module>,
    backward_cell: Box<dyn Module>,
    merge_mode: String,
}

impl BidirectionalRnn {
    pub fn new(
        forward_cell: Box<dyn Module>,
        backward_cell: Box<dyn Module>,
        merge_mode: String,
    ) -> Self {
        Self {
            forward_cell,
            backward_cell,
            merge_mode,
        }
    }

    fn reversed_input(input: &Tensor) -> Tensor {
        let data = input.data().clone();
        let seq_len = input.shape()[0];
        let mut reversed_data = Vec::with_capacity(data.len());
        for t in (0..seq_len).rev() {
            let mut row = Vec::new();
            for i in t..data.len() {
                row.push(data[i]);
            }
            reversed_data.extend(row);
        }
        Tensor::new(data.iter().rev().cloned().collect(), input.shape().clone()).unwrap()
    }
}

impl Module for BidirectionalRnn {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        let fwd_output = self.forward_cell.forward(input)?;
        let reversed = Self::reversed_input(input);
        let bwd_output = self.backward_cell.forward(&reversed)?;
        let reversed_bwd = Self::reversed_input(&bwd_output);
        match self.merge_mode.as_str() {
            "concat" => {
                let mut data = Vec::new();
                data.extend(fwd_output.data().iter().cloned());
                data.extend(reversed_bwd.data().iter().cloned());
                let seq_len = fwd_output.shape()[0];
                let hidden = fwd_output.shape()[1] + reversed_bwd.shape()[1];
                Tensor::new(data, vec![seq_len, hidden])
            }
            "sum" => {
                let mut data = Vec::new();
                for i in 0..fwd_output.data().len() {
                    data.push(fwd_output.data()[i] + reversed_bwd.data()[i]);
                }
                Tensor::new(data, fwd_output.shape().clone())
            }
            "avg" => {
                let mut data = Vec::new();
                for i in 0..fwd_output.data().len() {
                    data.push((fwd_output.data()[i] + reversed_bwd.data()[i]) / 2.0);
                }
                Tensor::new(data, fwd_output.shape().clone())
            }
            _ => {
                let mut data = Vec::new();
                data.extend(fwd_output.data().iter().cloned());
                data.extend(reversed_bwd.data().iter().cloned());
                let seq_len = fwd_output.shape()[0];
                let hidden = fwd_output.shape()[1] + reversed_bwd.shape()[1];
                Tensor::new(data, vec![seq_len, hidden])
            }
        }
    }

    fn parameters(&self) -> FVec<&Tensor> {
        let mut params = self.forward_cell.parameters();
        params.extend(self.backward_cell.parameters());
        params
    }

    fn train(&mut self, mode: FBool) {
        self.forward_cell.train(mode);
        self.backward_cell.train(mode);
    }
}

/// Stacked RNN with optional dropout between layers
struct StackedRnn {
    cells: FVec<Box<dyn Module>>,
    dropout: f32,
}

impl StackedRnn {
    pub fn new(cells: FVec<Box<dyn Module>>, dropout: f32) -> Self {
        Self { cells, dropout }
    }

    fn apply_dropout(input: &Tensor, p: f32, training: bool) -> Tensor {
        if !training || p == 0.0 {
            return input.clone();
        }
        let scale = 1.0 / (1.0 - p);
        let data: FVec<f32> = input
            .data()
            .iter()
            .enumerate()
            .map(|(i, &v)| {
                let hash = (i as u64)
                    .wrapping_mul(6364136223846793005)
                    .wrapping_add(1442695040888963407);
                let r = (hash % 10000) as f32 / 10000.0;
                if r < p { 0.0 } else { v * scale }
            })
            .collect();
        Tensor::new(data, input.shape().clone()).unwrap()
    }
}

impl Module for StackedRnn {
    fn forward(&self, input: &Tensor) -> Result<Tensor, MLError> {
        let mut current = input.clone();
        let training = !self.cells.is_empty();
        for (i, cell) in self.cells.iter().enumerate() {
            current = cell.forward(&current)?;
            if i < self.cells.len() - 1 {
                current = Self::apply_dropout(&current, self.dropout, training);
            }
        }
        Ok(current)
    }

    fn parameters(&self) -> FVec<&Tensor> {
        let mut params = Vec::new();
        for cell in &self.cells {
            params.extend(cell.parameters());
        }
        params
    }

    fn train(&mut self, mode: FBool) {
        for cell in &mut self.cells {
            cell.train(mode);
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_rnn_cell_new() {
        let cell = RnnCell::new(4, 8, true);
        assert_eq!(cell.input_size, 4);
        assert_eq!(cell.hidden_size, 8);
        assert!(cell.bias_ih.is_some());
        assert!(cell.bias_hh.is_some());
        let params = cell.parameters();
        assert_eq!(params.len(), 4);
    }

    #[test]
    fn test_lstm_cell_forward_step() {
        let cell = LstmCell::new(3, 5, true);
        let x = Tensor::ones(vec![1, 3]);
        let h0 = Tensor::zeros(vec![1, 5]);
        let c0 = Tensor::zeros(vec![1, 5]);
        let (h_next, c_next) = cell.forward_step(&x, &h0, &c0).unwrap();
        assert_eq!(h_next.shape(), &vec![1, 5]);
        assert_eq!(c_next.shape(), &vec![1, 5]);
    }

    #[test]
    fn test_gru_cell_forward_step() {
        let cell = GruCell::new(4, 6, true);
        let x = Tensor::ones(vec![1, 4]);
        let h0 = Tensor::zeros(vec![1, 6]);
        let h_next = cell.forward_step(&x, &h0).unwrap();
        assert_eq!(h_next.shape(), &vec![1, 6]);
    }

    #[test]
    fn test_lstm_forward_sequence() {
        let cell = LstmCell::new(3, 4, false);
        let input = Tensor::ones(vec![5, 3]);
        let h0 = Tensor::zeros(vec![1, 4]);
        let c0 = Tensor::zeros(vec![1, 4]);
        let (outputs, h_n, c_n) = cell.forward_sequence(&input, &h0, &c0).unwrap();
        assert_eq!(outputs.shape(), &vec![5, 4]);
        assert_eq!(h_n.shape(), &vec![1, 4]);
        assert_eq!(c_n.shape(), &vec![1, 4]);
    }

    #[test]
    fn test_bidirectional_concat() {
        let fwd = RnnCell::new(2, 3, false);
        let bwd = RnnCell::new(2, 3, false);
        let bi = BidirectionalRnn::new(Box::new(fwd), Box::new(bwd), "concat".to_string());
        let input = Tensor::ones(vec![4, 2]);
        let output = bi.forward(&input).unwrap();
        assert_eq!(output.shape(), &vec![4, 6]);
    }

    #[test]
    fn test_stacked_rnn() {
        let cell1 = RnnCell::new(2, 4, false);
        let cell2 = RnnCell::new(4, 3, false);
        let stacked = StackedRnn::new(vec![Box::new(cell1), Box::new(cell2)], 0.0);
        let input = Tensor::ones(vec![3, 2]);
        let output = stacked.forward(&input).unwrap();
        assert_eq!(output.shape(), &vec![3, 3]);
    }
}
