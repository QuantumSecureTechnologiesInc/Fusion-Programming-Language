#![allow(dead_code)]
use crate::ml::tensor::Tensor;
use crate::ml::MLError;

/// Mean Squared Error Loss
struct MseLoss {
    pub reduction: FString,
}

impl MseLoss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(&self, predictions: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if predictions.shape != targets.shape {
            return Err(MLError::DimensionMismatch {
                expected: predictions.shape.clone(),
                actual: targets.shape.clone(),
            });
        }
        let mut data = Vec::with_capacity(predictions.numel());
        for i in 0..predictions.numel() {
            let diff = predictions.data()[i] - targets.data()[i];
            data.push(diff * diff);
        }
        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / data.len() as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, predictions.shape().clone()).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// L1 Loss (Mean Absolute Error)
struct L1Loss {
    pub reduction: FString,
}

impl L1Loss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(&self, predictions: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if predictions.shape != targets.shape {
            return Err(MLError::DimensionMismatch {
                expected: predictions.shape.clone(),
                actual: targets.shape.clone(),
            });
        }
        let mut data = Vec::with_capacity(predictions.numel());
        for i in 0..predictions.numel() {
            data.push((predictions.data()[i] - targets.data()[i]).abs());
        }
        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / data.len() as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, predictions.shape().clone()).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// Cross-Entropy Loss
/// Computes -sum(target * log(softmax(logits))) with numerically stable log-softmax
struct CrossEntropyLoss {
    pub reduction: FString,
}

impl CrossEntropyLoss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(&self, logits: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if logits.shape.len() != 2 {
            return Err(MLError::InvalidShape(
                "CrossEntropyLoss expects 2D logits [batch, classes]".to_string(),
            ));
        }
        let batch_size = logits.shape[0];
        let num_classes = logits.shape[1];
        let mut data = Vec::with_capacity(batch_size);

        for b in 0..batch_size {
            let class_idx = *targets.get(&[b]).unwrap() as usize;
            if class_idx >= num_classes {
                return Err(MLError::InvalidShape(
                    format!("Target class {} exceeds number of classes {}", class_idx, num_classes),
                ));
            }
            // Numerically stable log-softmax: log(softmax(x)) = x - max(x) - log(sum(exp(x - max(x))))
            let mut max_val = f32::NEG_INFINITY;
            for c in 0..num_classes {
                let val = *logits.get(&[b, c]).unwrap();
                if val > max_val {
                    max_val = val;
                }
            }
            let mut log_sum_exp = 0.0;
            for c in 0..num_classes {
                log_sum_exp += (*logits.get(&[b, c]).unwrap() - max_val).exp();
            }
            log_sum_exp = log_sum_exp.ln() + max_val;
            let log_prob = *logits.get(&[b, class_idx]).unwrap() - log_sum_exp;
            data.push(-log_prob);
        }

        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / batch_size as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, vec![batch_size]).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// Negative Log Likelihood Loss
struct NllLoss {
    pub reduction: FString,
}

impl NllLoss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(&self, log_probs: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if log_probs.shape.len() != 2 {
            return Err(MLError::InvalidShape(
                "NllLoss expects 2D log_probs [batch, classes]".to_string(),
            ));
        }
        let batch_size = log_probs.shape[0];
        let mut data = Vec::with_capacity(batch_size);

        for b in 0..batch_size {
            let class_idx = *targets.get(&[b]).unwrap() as usize;
            let log_prob = *log_probs.get(&[b, class_idx]).unwrap();
            data.push(-log_prob);
        }

        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / batch_size as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, vec![batch_size]).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// Binary Cross-Entropy Loss
struct BinaryCrossEntropyLoss {
    pub reduction: FString,
}

impl BinaryCrossEntropyLoss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(&self, predictions: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if predictions.shape != targets.shape {
            return Err(MLError::DimensionMismatch {
                expected: predictions.shape.clone(),
                actual: targets.shape.clone(),
            });
        }
        let eps = 1e-7;
        let mut data = Vec::with_capacity(predictions.numel());
        for i in 0..predictions.numel() {
            let p = predictions.data()[i].clamp(eps, 1.0 - eps);
            let t = targets.data()[i];
            data.push(-(t * p.ln() + (1.0 - t) * (1.0 - p).ln()));
        }

        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / data.len() as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, predictions.shape().clone()).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// Huber Loss (Smooth L1)
struct HuberLoss {
    pub delta: f32,
    pub reduction: FString,
}

impl HuberLoss {
    pub fn new(delta: f32, reduction: FString) -> Self {
        Self { delta, reduction }
    }

    pub fn forward(&self, predictions: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if predictions.shape != targets.shape {
            return Err(MLError::DimensionMismatch {
                expected: predictions.shape.clone(),
                actual: targets.shape.clone(),
            });
        }
        let mut data = Vec::with_capacity(predictions.numel());
        for i in 0..predictions.numel() {
            let diff = (predictions.data()[i] - targets.data()[i]).abs();
            if diff < self.delta {
                data.push(0.5 * diff * diff / self.delta);
            } else {
                data.push(diff - 0.5 * self.delta);
            }
        }

        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / data.len() as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, predictions.shape().clone()).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// Cosine Embedding Loss
struct CosineEmbeddingLoss {
    pub margin: f32,
}

impl CosineEmbeddingLoss {
    pub fn new(margin: f32) -> Self {
        Self { margin }
    }

    pub fn forward(&self, x1: &Tensor, x2: &Tensor, targets: &Tensor) -> Result<Tensor, MLError> {
        if x1.shape != x2.shape {
            return Err(MLError::DimensionMismatch {
                expected: x1.shape.clone(),
                actual: x2.shape.clone(),
            });
        }
        if x1.shape.len() != 2 {
            return Err(MLError::InvalidShape(
                "CosineEmbeddingLoss expects 2D input [batch, dim]".to_string(),
            ));
        }

        let batch_size = x1.shape[0];
        let dim = x1.shape[1];
        let mut data = Vec::with_capacity(batch_size);

        for b in 0..batch_size {
            let mut dot = 0.0f32;
            let mut norm1 = 0.0f32;
            let mut norm2 = 0.0f32;
            for d in 0..dim {
                let v1 = *x1.get(&[b, d]).unwrap();
                let v2 = *x2.get(&[b, d]).unwrap();
                dot += v1 * v2;
                norm1 += v1 * v1;
                norm2 += v2 * v2;
            }
            let cosine = dot / (norm1.sqrt() * norm2.sqrt() + 1e-8);
            let target = *targets.get(&[b]).unwrap();
            if target == 1.0 {
                data.push(1.0 - cosine);
            } else {
                data.push((cosine - self.margin).max(0.0));
            }
        }

        let sum: f32 = data.iter().sum();
        Ok(Tensor::new(vec![sum / batch_size as f32], vec![1]).unwrap())
    }
}

/// KL Divergence Loss: KL(p || q) = sum(p * (log(p) - log(q)))
struct KLDivergenceLoss {
    pub reduction: FString,
}

impl KLDivergenceLoss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(&self, p: &Tensor, q: &Tensor) -> Result<Tensor, MLError> {
        if p.shape != q.shape {
            return Err(MLError::DimensionMismatch {
                expected: p.shape.clone(),
                actual: q.shape.clone(),
            });
        }
        let eps = 1e-7;
        let mut data = Vec::with_capacity(p.numel());
        for i in 0..p.numel() {
            let p_val = p.data()[i].clamp(eps, 1.0);
            let q_val = q.data()[i].clamp(eps, 1.0);
            data.push(p_val * (p_val.ln() - q_val.ln()));
        }

        match self.reduction.as_str() {
            "mean" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum / data.len() as f32], vec![1]).unwrap())
            }
            "sum" => {
                let sum: f32 = data.iter().sum();
                Ok(Tensor::new(vec![sum], vec![1]).unwrap())
            }
            "batchmean" => {
                let sum: f32 = data.iter().sum();
                let batch_size = p.shape()[0] as f32;
                Ok(Tensor::new(vec![sum / batch_size], vec![1]).unwrap())
            }
            "none" => Ok(Tensor::new(data, p.shape().clone()).unwrap()),
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

/// CTC Loss (Connectionist Temporal Classification)
struct CTCLoss {
    pub reduction: FString,
}

impl CTCLoss {
    pub fn new(reduction: FString) -> Self {
        Self { reduction }
    }

    pub fn forward(
        &self,
        log_probs: &Tensor,
        targets: &Tensor,
        input_lengths: &Tensor,
        target_lengths: &Tensor,
    ) -> Result<Tensor, MLError> {
        if log_probs.shape.len() != 3 {
            return Err(MLError::InvalidShape(
                "CTCLoss expects 3D log_probs [seq_len, batch, classes]".to_string(),
            ));
        }
        let seq_len = log_probs.shape[0];
        let batch_size = log_probs.shape[1];
        let num_classes = log_probs.shape[2];

        let mut total_loss = 0.0f32;

        for b in 0..batch_size {
            let input_len = *input_lengths.get(&[b]).unwrap() as usize;
            let target_len = *target_lengths.get(&[b]).unwrap() as usize;

            // Simple CTC: sum negative log probability of blank + target sequence
            // For a proper CTC forward-backward algorithm, this would need the full lattice
            // Here we use a simplified version that computes the loss for the alignment
            // where each target is roughly aligned to input_len / target_len positions

            let blank_prob_sum = 0.0f32;
            let mut alignment_loss = 0.0f32;

            // Compute alignment positions
            let mut positions: Vec<usize> = Vec::new();
            for t in 0..target_len {
                let pos = (t * input_len) / target_len;
                positions.push(pos);
            }

            // Add loss for each aligned position
            for (t, &pos) in positions.iter().enumerate() {
                if t < target_len {
                    let class_idx = *targets.get(&[b, t]).unwrap() as usize;
                    if class_idx < num_classes {
                        let log_prob = *log_probs.get(&[pos, b, class_idx]).unwrap();
                        alignment_loss -= log_prob;
                    }
                }
            }

            // Add blank probability for unused positions
            let used_positions: std::collections::HashSet<usize> = positions.iter().cloned().collect();
            for t in 0..input_len {
                if !used_positions.contains(&t) {
                    let log_prob = *log_probs.get(&[t, b, 0]).unwrap(); // blank is class 0
                    // Don't subtract - we want to maximize blank probability for unused
                }
            }

            total_loss += alignment_loss + blank_prob_sum;
        }

        match self.reduction.as_str() {
            "mean" => Ok(Tensor::new(vec![total_loss / batch_size as f32], vec![1]).unwrap()),
            "sum" => Ok(Tensor::new(vec![total_loss], vec![1]).unwrap()),
            "none" => {
                // Compute per-sample losses
                let mut per_sample = Vec::with_capacity(batch_size);
                for b in 0..batch_size {
                    let input_len = *input_lengths.get(&[b]).unwrap() as usize;
                    let target_len = *target_lengths.get(&[b]).unwrap() as usize;
                    let mut positions: Vec<usize> = Vec::new();
                    for t in 0..target_len {
                        let pos = (t * input_len) / target_len;
                        positions.push(pos);
                    }
                    let mut alignment_loss = 0.0f32;
                    for (t, &pos) in positions.iter().enumerate() {
                        if t < target_len {
                            let class_idx = *targets.get(&[b, t]).unwrap() as usize;
                            if class_idx < num_classes {
                                let log_prob = *log_probs.get(&[pos, b, class_idx]).unwrap();
                                alignment_loss -= log_prob;
                            }
                        }
                    }
                    per_sample.push(alignment_loss);
                }
                Ok(Tensor::new(per_sample, vec![batch_size]).unwrap())
            }
            _ => Err(MLError::InvalidShape(format!("Unknown reduction: {}", self.reduction))),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_mse_loss() {
        let loss_fn = MseLoss::new("mean".to_string());
        let pred = Tensor::new(vec![1.0, 2.0, 3.0], vec![3]).unwrap();
        let target = Tensor::new(vec![1.5, 2.5, 3.5], vec![3]).unwrap();
        let loss = loss_fn.forward(&pred, &target).unwrap();
        assert!((loss.data()[0] - 0.25).abs() < 1e-5);
    }

    #[test]
    fn test_l1_loss() {
        let loss_fn = L1Loss::new("mean".to_string());
        let pred = Tensor::new(vec![1.0, 2.0, 3.0], vec![3]).unwrap();
        let target = Tensor::new(vec![2.0, 3.0, 4.0], vec![3]).unwrap();
        let loss = loss_fn.forward(&pred, &target).unwrap();
        assert!((loss.data()[0] - 1.0).abs() < 1e-5);
    }

    #[test]
    fn test_cross_entropy_loss() {
        let loss_fn = CrossEntropyLoss::new("mean".to_string());
        let logits = Tensor::new(vec![2.0, 1.0, 0.5, 0.5, 1.5, 2.0], vec![2, 3]).unwrap();
        let targets = Tensor::new(vec![0.0, 2.0], vec![2]).unwrap();
        let loss = loss_fn.forward(&logits, &targets).unwrap();
        assert!(loss.data()[0] > 0.0);
    }

    #[test]
    fn test_nll_loss() {
        let loss_fn = NllLoss::new("mean".to_string());
        let log_probs = Tensor::new(vec![-0.5, -1.0, -2.0, -1.0, -0.5, -1.5], vec![2, 3]).unwrap();
        let targets = Tensor::new(vec![0.0, 1.0], vec![2]).unwrap();
        let loss = loss_fn.forward(&log_probs, &targets).unwrap();
        assert!(loss.data()[0] > 0.0);
    }

    #[test]
    fn test_binary_cross_entropy_loss() {
        let loss_fn = BinaryCrossEntropyLoss::new("mean".to_string());
        let pred = Tensor::new(vec![0.9, 0.1, 0.8], vec![3]).unwrap();
        let target = Tensor::new(vec![1.0, 0.0, 1.0], vec![3]).unwrap();
        let loss = loss_fn.forward(&pred, &target).unwrap();
        assert!(loss.data()[0] > 0.0);
    }

    #[test]
    fn test_huber_loss() {
        let loss_fn = HuberLoss::new(1.0, "mean".to_string());
        let pred = Tensor::new(vec![1.0, 2.0, 3.0], vec![3]).unwrap();
        let target = Tensor::new(vec![1.5, 2.5, 5.0], vec![3]).unwrap();
        let loss = loss_fn.forward(&pred, &target).unwrap();
        assert!(loss.data()[0] > 0.0);
    }

    #[test]
    fn test_cosine_embedding_loss() {
        let loss_fn = CosineEmbeddingLoss::new(0.5);
        let x1 = Tensor::new(vec![1.0, 0.0, 0.0], vec![1, 3]).unwrap();
        let x2 = Tensor::new(vec![0.0, 1.0, 0.0], vec![1, 3]).unwrap();
        let targets = Tensor::new(vec![-1.0], vec![1]).unwrap();
        let loss = loss_fn.forward(&x1, &x2, &targets).unwrap();
        assert!(loss.data()[0] >= 0.0);
    }

    #[test]
    fn test_kl_divergence_loss() {
        let loss_fn = KLDivergenceLoss::new("mean".to_string());
        let p = Tensor::new(vec![0.3, 0.7], vec![2]).unwrap();
        let q = Tensor::new(vec![0.5, 0.5], vec![2]).unwrap();
        let loss = loss_fn.forward(&p, &q).unwrap();
        assert!(loss.data()[0] > 0.0);
    }

    #[test]
    fn test_reduction_none() {
        let loss_fn = MseLoss::new("none".to_string());
        let pred = Tensor::new(vec![1.0, 2.0, 3.0], vec![3]).unwrap();
        let target = Tensor::new(vec![1.0, 3.0, 5.0], vec![3]).unwrap();
        let loss = loss_fn.forward(&pred, &target).unwrap();
        assert_eq!(loss.shape(), &vec![3]);
    }
}
