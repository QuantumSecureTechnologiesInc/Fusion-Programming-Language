// ─── Integrated compiler pipeline ─────────────────────────────────────────────

fn compile_with_features(code: string, uses: []string) -> string {
    let registry = feature_toggle_init()
    let _resolved = feature_toggle_resolve(registry, uses)
    let conflicts = feature_toggle_check_conflicts(uses)
    if conflicts.len() > 0 {
        return "// COMPILATION FAILED: feature conflicts detected\n// " + conflicts.join("\n// ")
    }
    let ordered = feature_toggle_get_order(uses)
    let mut result = code
    for pass_name in ordered {
        result = feature_toggle_inject_transforms([pass_name], result)
    }
    result
}

fn validate_features(uses: []string) -> bool {
    let conflicts = feature_toggle_check_conflicts(uses)
    conflicts.len() == 0
}

fn get_feature_order(uses: []string) -> []string {
    feature_toggle_get_order(uses)
}

