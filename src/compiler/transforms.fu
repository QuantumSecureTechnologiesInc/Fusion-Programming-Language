// src/compiler/transforms.fu
// Transform implementations for each feature toggle

fn cps_transform(code: string) -> string {
    let mut result = "// CPS Transform\n"
    result = result + "// Converts direct-style calls to continuation-passing style\n"
    result = result + "// Each function receives an explicit continuation parameter\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.has_prefix("fn ") {
            transformed = transformed + "// [CPS] " + line + "\n"
        } else if line.contains("return ") {
            let val = line.after("return ")
            transformed = transformed + "cont(" + val + ")\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn tco_loop_transform(code: string) -> string {
    let mut result = "// TCO Loop Transform\n"
    result = result + "// Converts self-recursive calls to iterative loops\n"
    result = result + "// Tail-call positions detected via last-expression analysis\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.has_prefix("fn ") {
            transformed = transformed + "// [TCO] " + line + "\n"
        } else if line.contains("recur ") {
            let args = line.after("recur ")
            transformed = transformed + "continue_loop(" + args + ")\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn linear_resource_tracking(code: string) -> string {
    let mut result = "// Linear Resource Tracking\n"
    result = result + "// Ensures resources are used exactly once\n"
    result = result + "// Insert move/borrow markers at use sites\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("let ") {
            transformed = transformed + line + " /* @linear */\n"
        } else if line.has_prefix("drop ") {
            transformed = transformed + "/* @linear_end */ " + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn capability_check_injection(code: string) -> string {
    let mut result = "// Capability Check Injection\n"
    result = result + "// Guards operations with required capability tokens\n"
    result = result + "// Requires linear feature for ownership tracking\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("io.") {
            transformed = transformed + "// @capability(IO)\n" + line + "\n"
        } else if line.contains("net.") {
            transformed = transformed + "// @capability(NET)\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn effect_handler_injection(code: string) -> string {
    let mut result = "// Effect Handler Injection\n"
    result = result + "// Wraps effectful operations with handler frames\n"
    result = result + "// Supports algebraic effect system with resume\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("perform ") {
            let effect = line.after("perform ")
            transformed = transformed + "with_effect(" + effect + ", handler)\n"
        } else if line.contains("handle ") {
            transformed = transformed + "// @handler_frame\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn dispatch_table_generation(code: string) -> string {
    let mut result = "// Dispatch Table Generation\n"
    result = result + "// Builds multimethod dispatch tables from type signatures\n"
    result = result + "// Generates vtable entries for generic functions\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.has_prefix("fn ") && line.contains("->") {
            transformed = transformed + "// @dispatch_table\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn refinement_check_insertion(code: string) -> string {
    let mut result = "// Refinement Check Insertion\n"
    result = result + "// Inserts runtime checks for refinement types\n"
    result = result + "// Validates predicates at boundaries\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("nat ") || line.contains("pos ") {
            transformed = transformed + "// @refinement_check\n" + line + "\n"
        } else if line.contains(": {") {
            transformed = transformed + "// @refinement_guard\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn dependent_check_insertion(code: string) -> string {
    let mut result = "// Dependent Check Insertion\n"
    result = result + "// Verifies dependent type constraints at runtime\n"
    result = result + "// Type-level computations checked against value-level witnesses\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("Vec[") && line.contains("]") {
            let size = line.between("[", "]")
            transformed = transformed + "// @dependent_check(len == " + size + ")\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn provenance_tracking_injection(code: string) -> string {
    let mut result = "// Provenance Tracking Injection\n"
    result = result + "// Tags unsafe operations with provenance metadata\n"
    result = result + "// Tracks origin of pointers for UB prevention\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("unsafe ") {
            transformed = transformed + "// @provenance_track\n" + line + "\n"
        } else if line.contains("*") {
            transformed = transformed + "/* @provenance */ " + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn actor_supervision_injection(code: string) -> string {
    let mut result = "// Actor Supervision Injection\n"
    result = result + "// Wraps actor spawning with supervision trees\n"
    result = result + "// Configures restart strategies and backoff\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("spawn ") {
            let actor = line.after("spawn ")
            transformed = transformed + "supervised_spawn(" + actor + ", strategy: one_for_one)\n"
        } else if line.contains("send ") {
            transformed = transformed + "// @actor_send\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn staging_specialization(code: string) -> string {
    let mut result = "// Staging Specialization\n"
    result = result + "// Partially evaluates staged computations at compile time\n"
    result = result + "// Generates specialized code for known values\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("stage ") {
            transformed = transformed + "// @compile_time_eval\n" + line + "\n"
        } else if line.contains("@staged") {
            transformed = transformed + "// @specialize\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

fn allocator_replacement(code: string) -> string {
    let mut result = "// Allocator Replacement\n"
    result = result + "// Swaps default allocator with custom pool/arena\n"
    result = result + "// Inserts allocation hooks at object creation sites\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("new ") || line.contains("alloc ") {
            transformed = transformed + "// @allocator(pool)\n" + line + "\n"
        } else if line.contains("free ") {
            transformed = transformed + "// @allocator_release\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}

