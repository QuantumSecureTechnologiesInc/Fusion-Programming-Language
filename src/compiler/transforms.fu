    let mut result = "// Gradual Annotation Check\n"
    result = result + "// Validates gradual typing annotations\n"
    result = result + "// Checks dynamic/static type boundaries\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.contains("dyn ") {
            transformed = transformed + "// @gradual_boundary\n" + line + "\n"
        } else if line.contains("any ") {
            transformed = transformed + "// @gradual_check\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
