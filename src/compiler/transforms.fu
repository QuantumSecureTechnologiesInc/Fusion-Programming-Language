fn tmc_transform(code: string) -> string {
    let mut result = "// Tail-Modulo-Cons Transform\n"
    result = result + "// Optimizes tail calls that construct data structures\n"
    result = result + "// Combines TCO with constructor reuse when possible\n"
    let lines = code
    let mut transformed = ""
    for line in lines {
        if line.has_prefix("fn ") {
            transformed = transformed + "// [TMC] " + line + "\n"
        } else if line.contains("recur ") && (line.contains("::") || line.contains("(")) {
            transformed = transformed + "// @tmc_reuse\n" + line + "\n"
        } else {
            transformed = transformed + line + "\n"
        }
    }
    result + transformed
}
