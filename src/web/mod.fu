// src/web/mod.fu
// Fusion Web Framework Module

pub mod http;
pub mod router;
pub mod server;
pub mod runtime;

pub use http::{WebServer, WebRequest, WebResponse};
pub use router::{Router, Route, add_route, match_route};
pub use server::{serve, start_server};
pub use runtime::{DomElement, dom_create, dom_set_attribute, dom_append_child, dom_render, dom_on_event};

/// Web Framework Error
#[derive(Debug, Clone)]
#[allow(dead_code)]
enum WebError {
    BindError(FString),
    RouteNotFound,
    InternalServerError(FString),
}
impl std::fmt::Display for WebError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            WebError::BindError(msg) => write!(f, "Bind error: {}", msg),
            WebError::RouteNotFound => write!(f, "Route not found"),
            WebError::InternalServerError(msg) => {
                write!(f, "Internal server error: {}", msg)
            }
        }
    }
}
