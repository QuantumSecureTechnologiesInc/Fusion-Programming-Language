// Integer Overflow Behavior
// Provides checked, wrapping, saturating, and safe arithmetic operations

extern fn checked_add(a: int, b: int) -> (int, bool)
extern fn checked_sub(a: int, b: int) -> (int, bool)
extern fn checked_mul(a: int, b: int) -> (int, bool)

extern fn wrapping_add(a: int, b: int) -> int
extern fn wrapping_sub(a: int, b: int) -> int

extern fn saturating_add(a: int, b: int) -> int
extern fn saturating_sub(a: int, b: int) -> int

// Safe arithmetic that panics on overflow
fn safe_add(a: int, b: int) -> int {
    let (result, overflow) = checked_add(a, b)
    if overflow {
        panic("integer overflow in addition: {} + {}", a, b)
    }
    return result
}

fn safe_sub(a: int, b: int) -> int {
    let (result, overflow) = checked_sub(a, b)
    if overflow {
        panic("integer overflow in subtraction: {} - {}", a, b)
    }
    return result
}

fn safe_mul(a: int, b: int) -> int {
    let (result, overflow) = checked_mul(a, b)
    if overflow {
        panic("integer overflow in multiplication: {} * {}", a, b)
    }
    return result
}
